//这里写新指针初始化
push esi
mov esi,158//从158开始循环归零到编号前的偏移
az1:
mov [edi+esi],ebx
add esi,4
cmp esi,ZombieClassSize-8
jne az1
pop esi
mov byte [edi+15E],-1

originalcode:
mov edx,[edi+04]
cmp edx,ebx

exit:
jmp returnhere

