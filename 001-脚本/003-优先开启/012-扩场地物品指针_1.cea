[ENABLE]
define(GridItemClassSize,20C)
registersymbol(GridItemClassSize)

//默认析构函数销毁
0041BDF3:
ADD EAX,GridItemClassSize
0041BE04:
imul ecx,ecx,GridItemClassSize
0041BE10:
test [eax+GridItemClassSize-4],edx
0041BE18:
ADD EAX,GridItemClassSize
0041BE2A:
movzx edi,word ptr [eax+GridItemClassSize-4]
0041BE3D:
mov [eax+GridItemClassSize-4],ecx
//遍历
0041CAE4:
ADD EAX,GridItemClassSize
0041CAEF:
imul ecx,ecx,GridItemClassSize
0041CB00:
test [eax+GridItemClassSize-4],edi
0041CB08:
ADD EAX,GridItemClassSize
//创建，申请内存
0041E1DB:
imul eax,eax,GridItemClassSize
0041E1E1:
mov edx,[eax+ecx+GridItemClassSize-4]
0041E1ED:
imul edi,edi,GridItemClassSize
0041E1F5:
push GridItemClassSize-4
0041E20A:
mov [edi+GridItemClassSize-4],eax
//析构函数销毁并释放
0041E7E8:
ADD ECX,GridItemClassSize
0041E7F1:
imul edx,edx,GridItemClassSize
0041E800:
test [ecx+GridItemClassSize-4],edi
0041E80B:
imul edx,edx,GridItemClassSize
0041E813:
ADD ECX,GridItemClassSize
0041E827:
movzx ebp,word ptr [ecx+GridItemClassSize-4]
0041E834:
mov [ecx+GridItemClassSize-4],edx
//重新赋值 mApp 和 mBoard
00481E63:
ADD EAX,GridItemClassSize
00481E6E:
imul ecx,ecx,GridItemClassSize
00481E80:
test [eax+GridItemClassSize-4],edx
00481E8C:
ADD EAX,GridItemClassSize
//保存数据
0048272C:
imul esi,esi,GridItemClassSize
[DISABLE]
unregistersymbol(GridItemClassSize)
