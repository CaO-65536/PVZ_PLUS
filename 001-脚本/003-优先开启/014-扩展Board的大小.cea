[ENABLE]
define(Boardsize,5800)//只有到Boardsize-4的内存能用
alloc(newmem,2048)
define(BushesRowNum,6)
define(mBushesAnimID_Offset,57BC)
define(mBushesAnimIDSize,BushesRowNum*4)
define(mBushesAnimID_Next_Offset,mBushesAnimID_Offset+mBushesAnimIDSize)
registersymbol(BushesRowNum)
registersymbol(mBushesAnimID_Offset)
registersymbol(mBushesAnimIDSize)
registersymbol(mBushesAnimID_Next_Offset)

newmem:
push eax
mov eax,57AC
az1:
mov [ebp+eax],ebx
add eax,4
cmp eax,Boardsize
jne short az1
//mov [ebp+57C0],FF
pop eax
jmp 408079
408073:
jmp newmem
nop
44F60E:
push Boardsize//创建时的大小
4819E0:
mov esi,Boardsize-164//存读档时的大小
[DISABLE]
dealloc(newmem)
unregistersymbol(BushesRowNum)
unregistersymbol(mBushesAnimID_Offset)
unregistersymbol(mBushesAnimIDSize)
unregistersymbol(mBushesAnimID_Next_Offset)
408073:
mov [ebp+000057AC],ebx
44F60E:
push 000057B0
4819E0:
mov esi,0000564C
