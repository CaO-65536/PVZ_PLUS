407CBC://公共上限
mov esi,number
407CA9://僵尸
push ZombieClassSize*number//15C*number//
407CC1://植物
push PlantClassSize*number//14C*number//
407D04://子弹
push ProjectilesClassSize*number
407D1B://物品
push D8*number
407D48://推车
push 48*number1
407D80://推车上限
mov [ebp+00000108],number1
407D75://场地物品
push GridItemClassSize*number
416886://绘制函数
mov eax,C0000//F28FC
