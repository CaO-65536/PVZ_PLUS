While:
mov eax,[ebp+04]
test eax,eax
je short NotRead
lea edx,[esp+18+04]
call 00441BE0
mov eax,[esp+18+04]
mov ecx,[esp]
mov [ebx+ecx],eax
jmp short Next
NotRead:
