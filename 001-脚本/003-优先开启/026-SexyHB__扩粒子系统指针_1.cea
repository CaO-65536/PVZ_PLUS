define(TodParticleSystemClassSize,50)
registersymbol(TodParticleSystemClassSize)
alloc(Code,512)
label(TodParticleSystem_ctor)
registersymbol(TodParticleSystem_ctor)
label(TodParticleSystem_dtor)
registersymbol(TodParticleSystem_dtor)
define(number,1000)

Code:
TodParticleSystem_ctor:
xor eax,eax
mov [ecx+0C],eax
mov [ecx+10],eax
mov [ecx+14],eax
mov [ecx+18],eax
mov [ecx+04],eax
mov [ecx+08],eax
mov [ecx+1C],al
mov [ecx+24],al
mov [ecx+1D],al
mov [ecx+20],eax
lea eax,[ecx+28]
call 5A3710
mov eax,ecx
ret

align 10 CC
TodParticleSystem_dtor:
push esi
mov esi,ecx
push esi
call 5160C0  // TodParticleSystem::ParticleSystemDie
add esi,0C
call 518B50  // TodList<ParticleEmitterID>::RemoveAll
pop esi
ret

