[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(LoadImage,1024)
registersymbol(LoadImage)

LoadImage:
push ebp
mov ebp,esp
sub esp,1C+0C
mov ecx,esp
mov edx,[ebp+0C]
push edx
xor eax,eax
mov [ecx+4],al
mov [ecx+14],eax
mov [ecx+18],F
call 404450
push eax
lea eax,[esp+1C+04]
call 59A8B0
mov esi,eax
push esi
mov ecx,[ebp+10]
call 5B8000
mov ecx,eax
call 59A980
mov ecx,[ebp+08]
mov [ecx],eax
call 59A8C0
mov ecx,esp
call 404420
mov esp,ebp
pop ebp
ret C
{
push //ResourceManager* this
push //const char* theID
push //Image* theImage
}

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(LoadImage)
unregistersymbol(LoadImage)
