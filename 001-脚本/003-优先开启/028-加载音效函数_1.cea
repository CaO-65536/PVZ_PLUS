[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(LoadSound,1024)
registersymbol(LoadSound)

LoadSound:
push ebp
mov ebp,esp
sub esp,1C
mov ecx,esp
mov edx,[ebp+0C]
push edx//字符串
xor eax,eax
mov [ecx+4],al
mov [ecx+14],eax
mov [ecx+18],F
call 404450//eax=字符串对象
mov ecx,[ebp+10]
push eax
mov edx,[ecx]
mov edx,[edx+44]
call edx
mov ecx,[ebp+08]
mov [ecx],eax
mov ecx,esp//字符串对象
call 404420
mov esp,ebp
pop ebp
ret C
{
push //ResourceManager* this
push //const char* theID
push //int* theSoundId
}

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(LoadSound)
unregistersymbol(LoadSound)
