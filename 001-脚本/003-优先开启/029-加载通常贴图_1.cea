[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
label(IMAGE_GOOGLYEYE)
registersymbol(IMAGE_GOOGLYEYE)

newmem:
mov [006A75C0],eax
push edi
push IMAGE_GOOGLYEYE_String
push IMAGE_GOOGLYEYE
call LoadImage

originalcode:
lea esi,[ebp-1C]

exit:
jmp returnhere

align 04,00
IMAGE_GOOGLYEYE:
dd 00000000

IMAGE_GOOGLYEYE_String:
db 'IMAGE_GOOGLYEYE' 00

478E0A:
jmp newmem
nop 3
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
unregistersymbol(IMAGE_GOOGLYEYE)
478E0A:
db 8D 75 E4 A3 C0 75 6A 00
