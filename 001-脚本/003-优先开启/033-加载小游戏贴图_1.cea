[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
label(IMAGE_CHALLENGE_NEWBACKGROUND)
label(IMAGE_CHALLENGE_NAME_BACK)
label(IMAGE_CHALLENGE_BUTTON_DOTTED)
registersymbol(IMAGE_CHALLENGE_NEWBACKGROUND)
registersymbol(IMAGE_CHALLENGE_NAME_BACK)
registersymbol(IMAGE_CHALLENGE_BUTTON_DOTTED)

newmem:
mov [006A780C],eax

push edi
push IMAGE_CHALLENGE_NEWBACKGROUND_String
push IMAGE_CHALLENGE_NEWBACKGROUND
call LoadImage

push edi
push IMAGE_CHALLENGE_NAME_BACK_String
push IMAGE_CHALLENGE_NAME_BACK
call LoadImage

push edi
push IMAGE_CHALLENGE_BUTTON_DOTTED_String
push IMAGE_CHALLENGE_BUTTON_DOTTED
call LoadImage

originalcode:
lea esi,[ebp-1C]

exit:
jmp returnhere

align 04,00
IMAGE_CHALLENGE_NEWBACKGROUND:
dd 00000000
IMAGE_CHALLENGE_NAME_BACK:
dd 00000000
IMAGE_CHALLENGE_BUTTON_DOTTED:
dd 00000000

IMAGE_CHALLENGE_NEWBACKGROUND_String:
db 'IMAGE_CHALLENGE_NEWBACKGROUND' 00
IMAGE_CHALLENGE_NAME_BACK_String:
db 'IMAGE_CHALLENGE_NAME_BACK' 00
IMAGE_CHALLENGE_BUTTON_DOTTED_String:
db 'IMAGE_CHALLENGE_BUTTON_DOTTED' 00

475C37:
jmp newmem
nop 3
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
unregistersymbol(IMAGE_CHALLENGE_NEWBACKGROUND)
unregistersymbol(IMAGE_CHALLENGE_NAME_BACK)
unregistersymbol(IMAGE_CHALLENGE_BUTTON_DOTTED)
475C37:
db 8D 75 E4 A3 0C 78 6A 00
//lea esi,[ebp-1C]
//mov [006A780C],eax
