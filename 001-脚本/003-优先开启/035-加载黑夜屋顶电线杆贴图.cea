[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
label(IMAGE_POLE_NIGHT)
registersymbol(IMAGE_POLE_NIGHT)

newmem:
mov [006A71D4],eax
push edi
push IMAGE_POLE_NIGHT_String
push IMAGE_POLE_NIGHT
call LoadImage

originalcode:
lea esi,[ebp-28]

exit:
jmp returnhere

align 04,00
IMAGE_POLE_NIGHT:
dd 00000000

IMAGE_POLE_NIGHT_String:
db 'IMAGE_POLE_NIGHT' 00

475A11:
jmp newmem
nop 3
returnhere:




[DISABLE]
