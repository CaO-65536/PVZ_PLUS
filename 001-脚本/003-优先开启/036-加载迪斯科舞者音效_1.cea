[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
label(DISCODANCERID)
label(DISCODANCER_SoundId)
registersymbol(DISCODANCERID)
registersymbol(DISCODANCER_SoundId)

newmem:
push esi
push DISCODANCERID
push DISCODANCER_SoundId
call LoadSound

originalcode:
push 0066C9E4//  ("SOUND_DIAMOND")

exit:
jmp returnhere

DISCODANCER_SoundId:
dd 00000000

DISCODANCERID:
db 'SOUND_DISCODANCER' 00

47E3F6:
jmp newmem
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
unregistersymbol(DISCODANCERID)
unregistersymbol(DISCODANCER_SoundId)
47E3F6:
db 68 E4 C9 66 00
//push 0066C9E4
