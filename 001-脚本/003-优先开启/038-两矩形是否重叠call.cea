[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(TwoRectIsOverlap,1024)
registersymbol(TwoRectIsOverlap)

TwoRectIsOverlap:
push ebx
push ecx
push edx
mov ebx,[esp+10]
mov ecx,[esp+14]
xor eax,eax
mov edx,[ebx]
add edx,[ebx+8]
cmp edx,[ecx]
jle end
mov edx,[ecx]
add edx,[ecx+8]
cmp edx,[ebx]
jle end
mov edx,[ebx+4]
add edx,[ebx+C]
cmp edx,[ecx+4]
jle end
mov edx,[ecx+4]
add edx,[ecx+C]
cmp edx,[ebx+4]
jle end
mov al,1
end:
pop edx
pop ecx
pop ebx
ret 0008

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(TwoRectIsOverlap)
unregistersymbol(TwoRectIsOverlap)
