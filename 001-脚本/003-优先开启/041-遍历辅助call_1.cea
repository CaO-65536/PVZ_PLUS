[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(UniForEach,1024)
registersymbol(UniForEach)

UniForEach:
push ebp
mov ebp,esp
push esi
push 00
UniForEach_Loop:
mov esi,esp
mov edx,[ebp+08]
call [ebp+0C]
test al,al
je short UniForEach_End
mov esi,[esi]
push [ebp+18]
push esi
call [ebp+14]
test al,al
je short UniForEach_Loop
push [ebp+18]
push esi
call [ebp+10]
test al,al
je short UniForEach_Loop
UniForEach_End:
add esp,4
pop esi
pop ebp
ret 014
{
push //void* AddintionalContent
push //bool Filter
push //bool Action
push //GameObject*& IterateFunction
push //Board* this

Filter:
push //void* AddintionalContent
push //GameObject* this
ret bool IsRight

Action:
push //void* AddintionalContent
push //GameObject* this
ret bool IsStopLoop

}

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(UniForEach)
unregistersymbol(UniForEach)
