[ENABLE]
alloc(SetCheckbox,2048)
registersymbol(SetCheckbox)

SetCheckbox:
push ebp
mov ebp,esp
push esi
push [ebp+8]
push [ebp+10]
push [ebp+C]
call 456860
add esp,C
mov esi,eax
push 2D
push 2E
push [ebp+18]
push [ebp+14]
mov ecx,esi
mov edx,[esi]
mov edx,[edx+A0]
call edx
mov eax,esi
pop esi
mov esp,ebp
pop ebp
ret 14

{
push y
push x
push Lisener
push ID
push defaultVal

ret eax=*Checkbox
}

[DISABLE]
dealloc(SetCheckbox)
unregistersymbol(SetCheckbox)
