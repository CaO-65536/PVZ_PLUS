[ENABLE]
alloc(ControlBoss,2048)
registersymbol(ControlBoss)

ControlBoss:
push esi
push edi
mov edi,eax
mov al,cl
mov esi,[edi+4]
cmp [edi+28],4F
jne Controlbosshead
cmp al,5A//z,跺脚(无僵尸卡),放置僵尸(持僵尸卡),放置蹦极三连(持蹦极卡)
jne short ControlBossstand1
mov eax,esi
call 40CD10
mov ecx,eax
call 42B530
test al,al
je BossStompAttack//z,(无僵尸卡)跺脚
mov eax,ecx
call 42A040
cmp eax,14
je short BossBungeeAttack
mov ecx,[esi+13C]
mov eax,edi
mov ecx,[ecx+28]
test ecx,ecx
jl end
call BossSetZombie
jmp end
BossStompAttack:
mov ecx,[esi+13C]
mov eax,edi
mov ecx,[ecx+28]
test ecx,ecx
jl end
call BossStomp
jmp end
BossBungeeAttack:
mov ecx,[esi+13C]
mov eax,edi
mov ecx,[ecx+24]
test ecx,ecx
jl end
call BossSetBungees
jmp end
ControlBossstand1:
cmp al,58//x,低头
jne short ControlBossstand2
mov eax,edi
call BossHeadEnter
jmp end
ControlBossstand2:
cmp al,43//c,扔车(无僵尸卡),放置蹦极三连(持蹦极卡)
jne end
mov eax,esi
call 40CD10
mov ecx,eax
call 42B530
test al,al
je BossRVAttack//c,(无僵尸卡)扔车
mov eax,ecx
call 42A040
cmp eax,14
je short BossSetBungee
BossRVAttack:
mov ecx,[esi+13C]
mov eax,edi
mov edx,[ecx+24]
test edx,edx
jl end
mov ecx,[ecx+28]
test ecx,ecx
jl end
call BossThrowCar
jmp end
BossSetBungee:
mov ecx,[esi+13C]
mov eax,edi
mov edx,[ecx+28]
test edx,edx
jl end
mov ecx,[ecx+24]
test ecx,ecx
jl end
call BossSetOneBungee
jmp end

Controlbosshead:
cmp [edi+28],57
je short Controlbossheadture
cmp [edi+28],59
je short Controlbossheadture
cmp [edi+28],58
jne short end
Controlbossheadture:
cmp al,5A//z,吐火球
jne short Controlbosshead1
mov ecx,[esi+13C]
mov eax,edi
mov ecx,[ecx+28]
test ecx,ecx
jl short end
call BossHeadSetFireBall
jmp short end
Controlbosshead1:
cmp al,43//c,吐冰球
jne short Controlbosshead2
mov ecx,[esi+13C]
mov eax,edi
mov ecx,[ecx+28]
test ecx,ecx
jl short end
call BossHeadSetIceBall
jmp short end
Controlbosshead2:
cmp al,58//x,起身
jne short end
mov eax,edi
call BossHeadLeave
//jmp short end
end:
pop edi
pop esi
ret

// eax = *Boss , ecx = theOrder
align 10,CC

BossSetZombie:
push ecx
push esi
push edi
mov edi,ecx
mov esi,eax
cmp dword ptr [esi+000000B4],00
jle BossSetZombieaz1
call 00532350
BossSetZombieaz1:
cmp dword ptr [esi+000000AC],00
jle BossSetZombieaz2
mov [esi+000000AC],00000000
call 0052F050
BossSetZombieaz2:
mov [esi+28],00000050
mov eax,edi
mov [esi+00000130],eax
cmp eax,04
jle short BossSetZombieaz3
mov eax,04
BossSetZombieaz3:
imul eax,10
add eax,0066F454
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 14
push 03
push eax
mov edi,esi
call 00528B00
mov eax,[esi]
mov esi,00000059
call 00453630
pop edi
pop esi
pop ecx
ret
// eax = *Boss , ecx = theRow
align 10,CC

BossHeadEnter:
push esi
push edi
mov edi,eax
mov [edi+28],00000056
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 14
push 03
push 0066F50C
call 00528B00
mov eax,[edi]
mov esi,00000059
call 00453630
pop edi
pop esi
ret
// eax = *Boss
align 10,CC

BossHeadSetFireBall:
sub esp,08
push ebx
push esi
push edi
mov edi,eax
mov ebx,ecx
mov eax,[edi]
mov [edi+28],00000059
mov [edi+148],ebx
mov al,1
mov [edi+0000014C],al
mov eax,ebx
cmp eax,4
jle short BossHeadSetFireBallaz2
mov eax,4
BossHeadSetFireBallaz2:
jmp 5354BB
// eax = *Boss , ecx = theRow
align 10,CC

BossHeadSetIceBall:
sub esp,08
push ebx
push esi
push edi
mov edi,eax
mov ebx,ecx
mov eax,[edi]
mov [edi+28],00000059
mov [edi+148],ebx
xor al,al
mov [edi+0000014C],al
mov eax,ebx
cmp eax,4
jle short BossHeadSetIceBallaz2
mov eax,4
BossHeadSetIceBallaz2:
jmp 5354BB
// eax = *Boss , ecx = theRow
align 10,CC

BossHeadLeave:
push edi
mov edi,eax
mov [edi+28],0000005A
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 00
push 03
push 0066F5F4
call 00528B00
pop edi
ret
// eax = *Boss
align 10,CC

BossSetBungees:
push ebx
push esi
push edi
mov esi,eax
mov ebx,ecx
cmp dword ptr [esi+000000B4],00
jle BossSetBungees1
call 00532350
BossSetBungees1:
cmp dword ptr [esi+000000AC],00
jle BossSetBungees2
mov [esi+000000AC],00000000
call 0052F050
BossSetBungees2:
mov [esi+28],00000052
mov ecx,esi
call 52BEE0
test al,al
mov eax,ebx
je short BossSetBungees3
sub eax,6
cmp eax,-2
jge short BossSetBungees5
mov eax,-2
BossSetBungees5:
test eax,eax
jle short BossSetBungees4
xor eax,eax
jmp short BossSetBungees4
BossSetBungees3:
cmp eax,2
jle short BossSetBungees4
mov eax,2
BossSetBungees4:
mov [esi+00000080],eax
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 14
push 03
push 0066F4E4
mov edi,esi
call 00528B00
mov eax,[edi]
mov esi,00000059
call 00453630
mov eax,[edi]
mov esi,0000002C
call 00453630
pop edi
pop esi
pop ebx
ret
// eax = *Boss , ecx = theColumn
align 10,CC

BossSetOneBungee:
push ebx
push esi
push edi
mov esi,eax
mov ebx,ecx
mov [esi+00000148],edx
cmp dword ptr [esi+000000B4],00
jle BossSetOneBungee1
call 00532350
BossSetOneBungee1:
cmp dword ptr [esi+000000AC],00
jle BossSetOneBungee2
mov [esi+000000AC],00000000
call 0052F050
BossSetOneBungee2:
mov [esi+28],00000052
mov [esi+00000188],0000001
mov ecx,esi
call 52BEE0
test al,al
mov eax,ebx
je short BossSetOneBungee3
sub eax,6
BossSetOneBungee3:
mov [esi+00000080],eax
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 14
push 03
push 0066F4E4
mov edi,esi
call 00528B00
mov eax,[edi]
mov esi,00000059
call 00453630
mov eax,[edi]
mov esi,0000002C
call 00453630
pop edi
pop esi
pop ebx
ret
// eax = *Boss , ecx = theColumn , edx = theRow
align 10,CC

BossStomp:
push ebx
push esi
mov esi,eax
mov ebx,ecx
cmp dword ptr [esi+000000B4],00
push edi
jle BossStomp1
call 00532350
BossStomp1:
cmp dword ptr [esi+000000AC],00
jle BossStomp2
mov [esi+000000AC],00000000
call 0052F050
BossStomp2:
mov [esi+28],00000051
mov eax,ebx
mov [esi+00000130],eax
cmp eax,3
jle short BossStomp3
mov eax,3
BossStomp3:
imul eax,10
add eax,0066F4A4
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 14
push 03
push eax
mov edi,esi
call 00528B00
mov eax,[esi]
mov esi,00000059
call 00453630
pop edi
pop esi
pop ebx
ret
// eax = *Boss , ecx = theRow
align 10,CC

BossThrowCar:
push ebx
push esi
push edi
mov esi,eax
mov ebx,ecx
mov edi,edx
cmp dword ptr [esi+000000B4],00
jle BossThrowCar1
call 00532350
BossThrowCar1:
cmp dword ptr [esi+000000AC],00
jle BossThrowCar2
mov [esi+000000AC],00000000
call 0052F050
BossThrowCar2:
mov [esi+28],00000055
cmp ebx,3
jle short BossThrowCar6
mov eax,[esi+4]
call 41C0D0
test al,al
je short BossThrowCar7
cmp ebx,4
jle short BossThrowCar6
mov ebx,4
jmp short BossThrowCar6
BossThrowCar7:
mov ebx,3
BossThrowCar6:
mov [esi+00000130],ebx
mov ecx,esi
call 52BEE0
test al,al
mov eax,edi
je short BossThrowCar3
sub eax,6
cmp eax,-2
jge short BossThrowCar5
mov eax,-2
BossThrowCar5:
test eax,eax
jle short BossThrowCar4
xor eax,eax
jmp short BossThrowCar4
BossThrowCar3:
cmp eax,2
jle short BossThrowCar4
mov eax,2
BossThrowCar4:
mov [esi+00000080],eax
fld dword ptr [00679798]
push ecx
fstp dword ptr [esp]
push 14
push 03
push 0066F448
mov edi,esi
call 00528B00
mov eax,[esi]
mov esi,00000059
call 00453630
pop edi
pop esi
pop ebx
ret
// eax = *Boss , ecx = theRow , edx = theColumn
align 10,CC

[DISABLE]
dealloc(ControlBoss)
unregistersymbol(ControlBoss)
