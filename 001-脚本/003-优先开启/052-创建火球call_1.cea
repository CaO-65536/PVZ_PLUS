[ENABLE]
alloc(AddAFireBall,2048)
registersymbol(AddAFireBall)

AddAFireBall:
push ebp
mov ebp,esp
push ebx
push esi
push edi
mov edi,[ebp+8]
lea esi,[edi+11C]
call 41E1C0
mov esi,eax
mov [esi+08],0000000D
mov ecx,[ebp+20]
mov [esi+C],ecx//是否为火球
mov ecx,[ebp+14]
mov [esi+18],ecx//僵王编号
mov ecx,[ebp+10]
mov [esi+3C],ecx//火球所属阵营
mov ecx,[ebp+C]
mov [esi+40],ecx//火球方向
mov ecx,[ebp+18]
mov [esi+14],ecx//火球行数
imul eax,ecx,00002710
add eax,0004AF3C
mov [esi+1C],eax//火球图层
push eax
push [ebp+1C]
mov eax,edi
mov ecx,[ebp+18]
call 41C6C0
fsub qword ptr [00679B48] { (90.00) }
push ecx
fstp [esp]
push [ebp+1C]
mov eax,[esi]
mov ebx,53
add ebx,[ebp+20]
call 00453C30
fld dword ptr [00679798] { (16.00) }
mov ebx,eax
fstp dword ptr [ebx+08]
lea eax,[ebx+1C]
fldz
push eax
fstp dword ptr [ebx+04]
lea ecx,[ebx+18]
fld dword ptr [00679378] { (-1.00) }
push ecx
mov edx,0066F5A8 { ("anim_form") }
fstp dword ptr [ebx+00000094]
mov eax,ebx
mov [ebx+10],00000003 { 3 }
mov [ebx+5C],00000000 { 0 }
call 004731D0
mov byte ptr [ebx+64],01
cmp [esi+C],0
je short IceBall
push 07
push 0066F5B4 { ("additive") }
call 004739E0
push 07
push 0066F5C0 { ("superglow") }
jmp short End
IceBall:
push 07 { 7 }
push 0066F5CC { ("ice_highlight") }
End:
call 004739E0
mov eax,[ebx+9C]
mov [esi+34],eax
pop edi
pop esi
pop ebx
mov esp,ebp
pop ebp
ret 1C
{
push //bool IsFireBall
push //float theX
push //int theRow
push //ZombieID theBoss
push //Bool IsBelongtoPlant
push //Bool IsBackwards
push //Board* this

ret eax=GridItem* aBall
}

[DISABLE]
dealloc(AddAFireBall)
unregistersymbol(AddAFireBall)
