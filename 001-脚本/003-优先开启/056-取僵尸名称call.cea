[ENABLE]
alloc(ZombieGetNameString,2048)
registersymbol(ZombieGetNameString)

ZombieGetNameString:
push ebp
mov ebp,esp
push ecx
push edx
push esi
mov eax,[ebp+C]
imul eax,eax,1C
add eax,[403460]
mov eax,[eax+18]
mov esi,[ebp+8]
push eax
cmp [ebp+10],1
je az1
push 6555A0//[%s]
jmp az2
az1:
push 0066907C//  ("[%s_TOOLTIP]")
//push 6554A4//[%s_TOOLTIP]
az2:
call 5B0CA0
add esp,8
pop esi
pop edx
pop ecx
mov esp,ebp
pop ebp
ret C

[DISABLE]
dealloc(ZombieGetNameString)
unregistersymbol(ZombieGetNameString)
