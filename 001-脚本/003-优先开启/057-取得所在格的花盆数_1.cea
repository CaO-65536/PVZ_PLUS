[ENABLE]
alloc(GetNumberOfFlowerPotsAt,2048)
registersymbol(GetNumberOfFlowerPotsAt)

GetNumberOfFlowerPotsAt:
push ebp
mov ebp,esp
push 0//花盆计数
push 0//开始序号(写0从头，写指针从后一个开始
push esi
push edi
star:
lea esi,[esp+8]
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je short end
mov esi,[esi]//esi=遍历对象的指针
cmp [esi+24],21
jne short star
cmp [esi+1C],ebx
jne short star
mov eax,[ebp+8]
cmp [esi+28],eax
jne short star
cmp byte [esi+00000141],0
jne short star
cmp byte [esi+00000142],0
jne short star
cmp [esi+00000142],2
je short star
mov eax,[ebp+C]
cmp esi,eax
je short end
inc [esp+C]
jmp short star
end:
mov eax,[esp+C]
pop edi
pop esi
mov esp,ebp
pop ebp
ret 8
{
push //thePlant
push //X
mov ebx,//Y
mov edx,//Boatd
}


[DISABLE]
dealloc(GetNumberOfFlowerPotsAt)
unregistersymbol(GetNumberOfFlowerPotsAt)
