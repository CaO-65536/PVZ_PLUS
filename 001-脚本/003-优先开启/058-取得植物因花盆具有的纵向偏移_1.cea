[ENABLE]
alloc(GetPlantHeightOffsetOfFlowerPots,2048)
registersymbol(GetPlantHeightOffsetOfFlowerPots)
label(exit)

GetPlantHeightOffsetOfFlowerPots:
push ebx
push esi
push edi
mov edi,[esp+4+C]
xor esi,esi
push edi
push [edi+28]
mov edx,[edi+04]
mov ebx,[edi+1C]
call GetNumberOfFlowerPotsAt
test eax,eax
je OnlyOneFlowerPot
cmp [edi+24],21
je short NotFlowerPot
dec eax
NotFlowerPot:
imul eax,#-26
add esi,eax
exit:
mov eax,esi
pop edi
pop esi
pop ebx
ret 4

OnlyOneFlowerPot:
cmp [edi+24],21
jne short exit
add esi,#26
jmp short exit
{
push //thePlant

ret
eax = aHeightOffset
}


[DISABLE]
dealloc(GetPlantHeightOffsetOfFlowerPots)
unregistersymbol(GetPlantHeightOffsetOfFlowerPots)
