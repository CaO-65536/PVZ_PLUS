cmp dword ptr [esi+00000134],02
je PlantTakeDamage_End
cmp byte ptr [esi+00000141],00
jne PlantTakeDamage_End
mov eax,ebp
test eax,eax
jle short PlantTakeDamage_End
//飞行单位
{cmp eax,23
jne short NotFlyingPlant
test bl,08
jne short FlyingPlant_L1
mov [esi+54],00000019
FlyingPlant_L1:
NotFlyingPlant:}
