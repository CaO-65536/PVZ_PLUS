[ENABLE]
alloc(DoImpactToPlant,2048)
registersymbol(DoImpactToPlant)

DoImpactToPlant:
push esi
push edi
mov esi,eax
mov edi,ecx
push 0
mov eax,edi
call 46DD30
mov eax,edi
mov ecx,esi
call IsSplashDamageToPlant
test al,al
je DoImpactToPlant_NotSplashDamageToPlant
cmp [edi+5C],6
jne short DoImpactToPlant_SplashDamage
test esi,esi
je short DoImpactToPlant_SplashDamage
mov eax,esi
call PlantRemoveColdEffects
DoImpactToPlant_SplashDamage:
push esi
mov eax,edi
call DoSplashDamageToPlant
jmp short DoImpactToPlant_End
DoImpactToPlant_NotSplashDamageToPlant:
test esi,esi
je short DoImpactToPlant_End
mov eax,esi
call GetDamageFlagsToPlant
mov ecx,[edi+5C]
lea ecx,[ecx+ecx*2]
mov edx,[ecx*4+ProjectileNewDefinition+8]
push edx
call PlantTakeDamage
cmp [edi+5C],C
jne short DoImpactToPlant_End
mov eax,esi
call PlantApplyButter
DoImpactToPlant_End:
xor eax,eax
mov ecx,edi
call 46E000
pop edi
pop esi
ret
{
mov eax,//Plant* thePlant = 0
mov ecx,//Projectile* this
}
align 10,CC

GetDamageFlagsToPlant:
push esi
push ebx
xor ebx,ebx
mov esi,eax
mov ecx,eax
mov eax,edi
call IsSplashDamageToPlant
test al,al
je short GetDamageFlagsToPlant_NotSplash
or ebx,02
GetDamageFlagsToPlant_NotSplash:
cmp [edi+58],1
jne short GetDamageFlagsToPlant_NotFromSky
or ebx,1
GetDamageFlagsToPlant_NotFromSky:
mov eax,[edi+5C]
cmp eax,01
je short GetDamageFlagsToPlant_Cold
cmp eax,05
jne short GetDamageFlagsToPlant_NotCold
GetDamageFlagsToPlant_Cold:
or ebx,04
GetDamageFlagsToPlant_NotCold:
or ebx,10//对植物清除尸体
mov eax,ebx
pop ebx
pop esi
ret
{
mov eax,//Plant* thePlant
mov edi,//Projectile* this
}
align 10,CC

IsSplashDamageToPlant:
push esi
mov esi,eax
xor al,al
mov ecx,[esi+5C]
cmp ecx,3
je IsSplashDamageToPlant_YesSplash
cmp ecx,5
je IsSplashDamageToPlant_YesSplash
cmp ecx,6
jne IsSplashDamageToPlant_NoSplash
IsSplashDamageToPlant_YesSplash:
mov al,1
IsSplashDamageToPlant_NoSplash:
pop esi
ret
{
mov ecx,//Plant* thePlant = 0
mov eax,//Projectile* this
}
align 10,CC

IsPlantHitBySplash:
sub esp,20
push ebx
push ebp
mov ebp,[esp+2C]
push esi
push edi
lea ecx,[esp+10]
mov esi,ebp
mov ebx,eax
call 46EBC0
cmp dword ptr [ebp+5C],06
jne short IsPlantHitBySplash_L1
mov [esp+18],00000064
IsPlantHitBySplash_L1:
mov esi,[ebx+1C]
sub esi,[ebp+1C]
lea eax,[esp+20]
mov ecx,ebx
call 467EF0
mov eax,ebp
mov ecx,ebx
call IsSplashDamageToPlant
test al,al
je short IsPlantHitBySplash_Not
cmp eax,19
jne short IsPlantHitBySplash_L2
xor esi,esi
IsPlantHitBySplash_L2:
cmp dword ptr [ebp+5C],06
jne short IsPlantHitBySplash_L3
test esi,esi
je short IsPlantHitBySplash_L4
//jmp short IsPlantHitBySplash_Not
IsPlantHitBySplash_Not:
xor al,al
IsPlantHitBySplash_End:
pop edi
pop esi
pop ebp
pop ebx
add esp,20
ret 0004
IsPlantHitBySplash_L3:
add esi,01
cmp esi,02
ja short IsPlantHitBySplash_Not
IsPlantHitBySplash_L4:
mov eax,[ebp+74]
push eax
mov esi,ebx
call PlantEffectedByDamage//00531A80
test al,al
je short IsPlantHitBySplash_Not
//攻击能力范围
lea edi,[esp+10]
lea ecx,[esp+20]
call 41C820
test eax,eax
jl short IsPlantHitBySplash_Not
mov al,1
jmp short IsPlantHitBySplash_End
{mov ecx,[esp+10]
mov edx,[esp+20]
cmp ecx,edx
jnl short IsPlantHitBySplash_L5
mov eax,[esp+18]
mov esi,[esp+28]
add eax,ecx
mov ecx,edx
add edx,esi
jmp short IsPlantHitBySplash_L6
IsPlantHitBySplash_L5:
mov eax,[esp+28]
add eax,edx
mov edx,[esp+18]
add edx,ecx
IsPlantHitBySplash_L6:
cmp eax,ecx
jg short IsPlantHitBySplash_L7
IsPlantHitBySplash_L8:
sub eax,ecx
test eax,eax
setge al
pop edi
pop esi
pop ebp
pop ebx
add esp,20
ret 0004
IsPlantHitBySplash_L7:
cmp eax,edx
jle short IsPlantHitBySplash_L8}
pop edi
//sub edx,ecx
//mov eax,edx
pop esi
//test eax,eax
pop ebp
//setge al
pop ebx
add esp,20
ret 0004
{
mov eax,//Plant* thePlant = 0
push //Projectile* this
}
align 10,CC

DoSplashDamageToPlant:
sub esp,08
push ebx
push ebp
push esi
push edi
mov edi,eax
mov eax,[edi+5C]
mov edx,[edi+04]
lea ebx,[eax+eax*2]
xor ebp,ebp
lea esi,[esp+10]
lea ebx,[ebx*4+ProjectileNewDefinition]
mov [esp+14],ebp
mov [esp+10],ebp
call 41C950//0041C8F0
test al,al
je short DoSplashDamageToPlant_L1
DoSplashDamageToPlant_L3:
mov eax,[esp+10]
cmp [esp+1C],eax
je short DoSplashDamageToPlant_L2
cmp [eax+24],21
jne short DoSplashDamageToPlant_LA
cmp byte [eax+00000148],1
je short DoSplashDamageToPlant_L2
DoSplashDamageToPlant_LA:
push edi
call IsPlantHitBySplash//0046D2B0
test al,al
je short DoSplashDamageToPlant_L2
add ebp,01
DoSplashDamageToPlant_L2:
mov edx,[edi+04]
lea esi,[esp+10]
call 41C950//0041C8F0
test al,al
jne  short DoSplashDamageToPlant_L3
mov [esp+14],ebp
DoSplashDamageToPlant_L1:
mov ebp,[ebx+08]
mov eax,55555556
imul ebp
mov ebx,edx
shr ebx,1F
lea ecx,[ebp*8+00000000]
add ebx,edx
sub ecx,ebp
cmp dword ptr [edi+5C],06
jne short DoSplashDamageToPlant_L4
mov ecx,ebp
DoSplashDamageToPlant_L4:
mov edx,ebx
imul edx,[esp+14]
cmp edx,ecx
jle short DoSplashDamageToPlant_L5
mov eax,ebp
imul eax,ecx
lea ecx,[edx+edx*2]
cdq
idiv ecx
mov ebx,00000001
cmp eax,01
jl short DoSplashDamageToPlant_L5
mov ebx,eax
DoSplashDamageToPlant_L5:
mov edx,[edi+04]
lea esi,[esp+10]
mov [esp+10],00000000
call 41C950//0041C8F0
test al,al
je short DoSplashDamageToPlant_End
DoSplashDamageToPlant_L9:
mov esi,[esp+10]
push edi
mov eax,esi
call IsPlantHitBySplash//0046D2B0
test al,al
je short DoSplashDamageToPlant_L6
mov eax,esi
cmp [eax+24],21
jne short DoSplashDamageToPlant_LB
cmp byte [eax+00000148],1
je short DoSplashDamageToPlant_L6
DoSplashDamageToPlant_LB:
call GetDamageFlagsToPlant//0046D230
cmp [esp+1C],esi
jne short DoSplashDamageToPlant_L7
push ebp
jmp short DoSplashDamageToPlant_L8
DoSplashDamageToPlant_L7:
push ebx
DoSplashDamageToPlant_L8:
call NormallyHitPlant//005317C0
DoSplashDamageToPlant_L6:
mov edx,[edi+04]
lea esi,[esp+10]
call 41C950//0041C8F0
test al,al
jne short DoSplashDamageToPlant_L9
DoSplashDamageToPlant_End:
pop edi
pop esi
pop ebp
pop ebx
add esp,08
ret 0004
{
push //Plant* thePlant = 0
mov eax,//Projectile* this
}
align 10,CC

[DISABLE]
dealloc(DoImpactToPlant)
unregistersymbol(DoImpactToPlant)
