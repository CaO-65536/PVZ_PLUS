label(DestroyFireball)
registersymbol(DestroyFireball)

newmem:
push edi
push ebx
mov eax,[edi+4]
call AddAFireBallByOriginalBall
mov edx,[edi]
jmp 00535B87

AddAFireBallByOriginalBall:
push ebx
mov ebx,[esp+8+4]//Zombie* theBoss
push edi
mov edi,[esp+4+8]//Reanimation* theBall
push esi
mov esi,eax
add esi,0000011C
call 0041E1C0
mov [eax+08],0000000D
movzx ecx,byte [ebx+14C]
mov [eax+C],ecx//是否为火球
or ecx,-1
mov [eax+10],ecx//火球列数
mov ecx,[ebx+148]
mov [eax+14],ecx//火球行数
mov ecx,[ebx+ZombieClassSize-4]
mov [eax+18],ecx//僵王编号
mov ecx,[edi+68]
mov [eax+1C],ecx//火球图层
mov ecx,[edi+9C]
mov [eax+34],ecx//火球动画编号
movzx ecx,byte [ebx+B8]
mov [eax+3C],ecx//火球所属阵营
mov byte ptr [edi+64],01//火球被使用
mov ecx,ebx
mov ebx,eax
call 52BEE0
movzx eax,al
mov [ebx+40],eax
mov eax,ebx
pop esi
pop edi
pop ebx
ret 0008
{
push //Zombie* theBoss
push //Reanimation* theBall
eax = Board* this

eax = Griditem* aFireball
}
align 10,CC

Destroyball:
cmp [eax+0C],01
jne +06
call DestroyIceball
ret
push eax
call DestroyFireball
ret
{
mov eax,Griditem* this
}
align 10,CC

