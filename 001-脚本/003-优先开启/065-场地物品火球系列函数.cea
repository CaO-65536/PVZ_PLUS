call 4733F0
mov ebx,[ebx+04]
mov edi,0000004E
call 41DA50
DestroyIceball_End:
call 44D000
pop edi
pop esi
pop ebx
//add esp,08
ret
{
mov eax,Griditem* this
}
align 10,CC

DestroyFireball:
