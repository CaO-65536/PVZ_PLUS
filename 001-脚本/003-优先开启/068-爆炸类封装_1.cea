526CD7://小丑不直接炸罐子
jmp 00526D02
alloc(newmem,2048)

newmem:
mov [esp+10],edi
mov [esp+14],ebx
mov ecx,[esi+1C]
mov edx,[esi+04]
cmp byte ptr [esi+000000B8],00
je short NoMindControlled
push 7F
jmp short next1
NoMindControlled:
push FF
next1:
push 01
push 01
push JackInTheBoxZombieRadius
push ebx
push edi
push ecx
push edx
call UnitedBoom
jmp 00526C84

newmem1:
push 00
mov eax,edi
call 45EB10
push eax//int theDamageRangeFlags
push 01//bool theBurn
push [edi+1C]//int theRow
push [edi+04]//Board* this
call UnitedBurnRow
jmp 0046697E

newmem2:
push 00
mov eax,ebx
call 45EB10
push eax//int theDamageRangeFlags
push [ebx+04]//Board* this
call UnitedIce
jmp 004669FF

newmem3:
cmp byte ptr [edi+B8],0
jne short BeMindControlled
push FF
jmp short UseUnitedBurnRow
BeMindControlled:
push 7F
UseUnitedBurnRow:
push 01
push [edi+1C]
push [edi+04]
call UnitedBurnRow
jmp 0052773E

526C37://小丑
jmp newmem
nop 2
466975://辣椒
jmp newmem1
nop 4
4669F8://寒冰菇
jmp newmem2
nop 2
5276BB://辣椒僵尸
