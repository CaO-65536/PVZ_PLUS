[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(ColorGradient,1024)
registersymbol(ColorGradient)

ColorGradient:
push edi
push ebx
mov edi,ecx
mov ebx,[edi+14]//theLapTime
mov edx,[edi+10]//theStage
test edx,edx
jne short ColorGradient_Stage1
push 01
push FF
push 00
mov eax,[edi+08]
add eax,01
mov ecx,ebx
xor edx,edx
call 00511C40
add esp,0C
mov [edi+08],eax
cmp eax,FF
jl ColorGradient_End
add [edi+10],1
jmp ColorGradient_End

ColorGradient_Stage1:
cmp edx,01
jne short ColorGradient_Stage2
push 01
push 00
push FF
mov eax,FF
sub eax,[edi]
add eax,01
mov ecx,ebx
xor edx,edx
call 00511C40
add esp,0C
mov [edi],eax
test eax,eax
jg ColorGradient_End
add [edi+10],1
jmp ColorGradient_End

ColorGradient_Stage2:
cmp edx,02
jne short ColorGradient_Stage3
push 01
push FF
push 00
mov eax,[edi+04]
add eax,01
mov ecx,ebx
xor edx,edx
call 00511C40
add esp,0C
mov [edi+04],eax
cmp eax,FF
jl ColorGradient_End
add [edi+10],1
jmp ColorGradient_End

ColorGradient_Stage3:
cmp edx,03
jne short ColorGradient_Stage4
push 01
push 00
push FF
mov eax,FF
sub eax,[edi+08]
add eax,01
mov ecx,ebx
xor edx,edx
call 00511C40
add esp,0C
mov [edi+08],eax
test eax,eax
jg ColorGradient_End
add [edi+10],1
jmp ColorGradient_End

ColorGradient_Stage4:
cmp edx,04
jne short ColorGradient_Stage5
push 01
push FF
push 00
mov eax,[edi]
add eax,01
mov ecx,ebx
xor edx,edx
call 00511C40
add esp,0C
mov [edi],eax
cmp eax,FF
jl short ColorGradient_End
add [edi+10],1
jmp short ColorGradient_End

ColorGradient_Stage5:
cmp edx,05
jne short ColorGradient_End
push 01
push 00
push FF
mov eax,FF
sub eax,[edi+04]
add eax,01
mov ecx,ebx
xor edx,edx
call 00511C40
add esp,0C
mov [edi+04],eax
test eax,eax
jg short ColorGradient_End
xor eax,eax
mov [edi+10],eax
ColorGradient_End:
pop ebx
pop edi
ret
{
mov ecx,//ColorGradient* this
}



{class ColorGradient} {
public:
       Color Color
       int Stage;
       int LapTime;
}



[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(ColorGradient)
unregistersymbol(ColorGradient)
