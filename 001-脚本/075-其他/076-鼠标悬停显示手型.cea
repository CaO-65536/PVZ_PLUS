mov edx,ebx
//sub edx,[eax+0C]
add edx,[ecx+34]
push edx
mov edx,esi
//sub edx,[eax+08]
push edx
call SliderThumbTestMouse
test al,al
jne 0040E64B}

originalcode:
cmp eax,04
jne 0040E67C

exit:
jmp returnhere

40E639:
jmp newmem
returnhere:


 
 
[DISABLE]
