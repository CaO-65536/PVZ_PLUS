[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
define(HITRESULTTYPE_SPECIALZOMBIE,16)
define(HITRESULTTYPE_DUPLICATORCARD,17)
define(HITRESULTTYPE_SEEDBANKSLIDER,18)
define(HITRESULTTYPE_WEAPON,19)
registersymbol(HITRESULTTYPE_SPECIALZOMBIE)
registersymbol(HITRESULTTYPE_DUPLICATORCARD)
registersymbol(HITRESULTTYPE_SEEDBANKSLIDER)
registersymbol(HITRESULTTYPE_WEAPON)

newmem:
