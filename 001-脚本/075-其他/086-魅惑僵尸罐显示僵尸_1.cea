[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp eax,04
je short exit

originalcode:
cmp eax,02
jne 0044DD5B

exit:
jmp returnhere

44DC95:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
44DC95:
cmp eax,02
jne 0044DD5B
