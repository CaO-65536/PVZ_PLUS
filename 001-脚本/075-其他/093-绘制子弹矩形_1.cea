[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
call 0046E540

originalcode:
sub esp,10
push esi
push edi
mov edi,esi
mov esi,[ebx]
mov eax,[esi]
mov eax,[eax+82C]
mov eax,[eax+PlayerInfo_GameSetting_Offset+2*4]
test al,al
je end
mov cl,1
mov [edi+48],cl
mov [edi+30],FF
mov [edi+34],FF
mov [edi+38],FF
mov [edi+3C],FF
lea eax,[esp+8]
call 46EBC0
xor ecx,ecx
mov [eax],ecx
mov [eax+4],ecx
push edi
call 586EF0
end:
pop edi
pop esi
add esp,10

exit:
jmp returnhere

4171D0:
