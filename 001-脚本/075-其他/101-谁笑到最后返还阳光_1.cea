[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
add [edi+0000579C],ebx
mov eax,[edi+8C]
cmp [eax+7F8],#31
jne short originalcode
mov eax,[edi+160]
mov eax,[eax+54]
cmp eax,A
je short originalcode
mov eax,[ebp+44]
push eax
fild [esp]
fmul [679664]//0.8
fistp [esp]
pop eax
cmp [ebp+40],eax
jl HPTooLow
mov edx,[ebp+138]//模仿者ID
mov eax,[ebp+24]//植物ID
call 41DAE0//eax=价格
push esi
{xor esi,esi
az1:
test eax,eax
jle short az2
sub eax,19
inc esi
jmp short az1}
mov cx,19
cdq
sub eax,edx
idiv cx
movzx esi,ax
az2:
test esi,esi
je short az3
push 3//运动  0从天而降1慢一点从天而降2弹出3力更大弹出4被捡5等一下被捡6场外弹出7固定顶端(后续同样)
push 4{种类  1银币2金币3钻石4阳光5小阳光6大阳光8奖杯9铲子A图鉴B钥匙C罐子D水壶E玉米卷F字条10卡片(调用要设定id)11礼物12钱袋13不消失礼物14钱袋15银向日葵奖杯16金向日葵奖杯17巧克力18不消失巧克力19迷你游戏礼物1A解密礼物1B生存礼物}
push [ebp+C]//列像素
push [ebp+8]//行像素
mov ecx,edi
call 40CB10
dec esi
jmp short az2
az3:
pop esi

originalcode:

exit:
jmp returnhere

HPTooLow:
push 1//形式 1,2双项选择,3单项选择,否则无项
push wc1//右项内容
push wc2//左项内容(必填)
push wc3//介绍(必填)
push wc4//标题(必填)
push 64//宽度
push [ebp]
call 4504B0//eax-1000是选项
sub eax,#1000
test eax,eax
je short exit
jmp 4111AE

wc1:
db C8 A1 CF FB 00//取消

wc2:
db C8 B7 B6 A8 00//确定

wc3:
db C8 E7 B9 FB BC CC D0 F8 B2 F9 B3 FD BD AB CE DE B7 A8 B7 B5 BB B9 D1 F4 B9 E2 00//如果继续铲除将无法返还阳光

wc4:
db B8 C3 D6 B2 CE EF D2 D1 CA DC C9 CB 00//该植物已受伤

4111D8:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
