label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
push ecx
push edx
mov eax,[ecx+4]
call 41BE50
test al,al
pop edx
pop ecx
pop eax
jne 40AE9A

originalcode:
mov ecx,[ecx+24]
cmp ecx,06

exit:
jmp returnhere

40AE76:
jmp newmem
nop
returnhere:


 
 
