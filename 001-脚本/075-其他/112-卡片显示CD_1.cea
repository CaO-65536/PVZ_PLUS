[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
mov eax,[esi+28]
sub eax,[esi+24]
movzx eax,ax
cdq
sub eax,edx
mov bx,64
idiv bx
movzx eax,ax
movzx edx,dx
push esi
lea esi,[esp+34]//输出地址
push edx//填充物*n
push eax//填充物*n
push wc//被处理字符串 %s(字符串)；%d(数字)；%Xd(数字补零至X位)；%.Xf(保留X位小数)；%%(百分号)
call 5B0CA0//eax=字符串对象
add esp,C//+4*n
pop esi
jmp 40F88B

wc:
db BB B9 D0 E8 25 64 2E 25 64 C3 EB 00//73 00

40F87D:
jmp newmem
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
40F87D:
push 0065620C
//Alt: db 68 0C 62 65 00
