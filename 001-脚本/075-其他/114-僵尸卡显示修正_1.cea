[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
mov eax,[esp+1C]
call 42B530
test al,al
je short az1
mov eax,[esp+1C]
call 42B530
cmp eax,49
je short az2
cmp eax,5C
jne short az3
az2:
fld [esp+8]
fsub qword ptr [00679318]
fstp [esp+8]
az3:
fld [esp+8]
fsub qword ptr [00679920]
fstp [esp+8]
fld dword ptr [00679F50]
fstp [esp+4]
az1:
mov eax,[ebx+4]
cmp [eax+5D8+ebp*4],0
pop eax
jne short originalcode
add esp,8
jmp 004390BA
originalcode:
push 00
push ecx
mov ecx,[eax+2C]

exit:
jmp returnhere

4390AC:
jmp newmem
nop
returnhere:


 
 
