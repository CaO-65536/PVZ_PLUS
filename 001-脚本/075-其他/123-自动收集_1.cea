[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [ebx+4C],64
jl originalcode
cmp [ebx+58],6
jg originalcode
xor eax,eax
cmp [ebx+50],al
jne originalcode
push eax
mov ecx,ebx
call 432C00

originalcode:
mov edx,[ebx]
mov eax,[edx+000007FC]

exit:
jmp returnhere

43150A:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]
