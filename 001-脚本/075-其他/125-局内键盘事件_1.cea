[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov [esi+57B4],edi
push ebx
mov eax,[esi+8C]
cmp [eax+7FC],3
jne originalcode

cmp edi,72
jne short GetCard
mov ecx,[esi+0000008C]
call DoGameSettingDialog
jmp originalcode

GetCard:
mov ebx,[esi+138]//取卡
cmp edi,30//1~0
jl TakeShovel
cmp edi,39
jg TakeShovel
cmp edi,30
jne short az1
mov edi,3A
az1:
sub edi,31
mov eax,[ebx+30]
cmp eax,6
jne short az3
push edi
mov edi,esi
call 412330
pop edi
jmp short SeedPacket
az3:
test eax,eax
je short SeedPacket
cmp eax,1
je short SeedPacket
cmp eax,2
jne originalcode
SeedPacket:
mov eax,[esi+144]
lea ecx,[edi+1]
cmp ecx,[eax+24]
jg originalcode

mov edx,[eax+SeedBankMax*50+mSeedPacket_Offest+10]
test edx,edx
je short SeedPacket_Next
fld qword ptr [edx+00000090]
mov edx,[eax+24]
sub edx,0A
imul edx,edx,33
push edx
fchs
fimul [esp]
fistp dword ptr [esp]
pop edx

push ebx
xor ebx,ebx
SeedPacket_While:
imul ecx,ebx,50
lea ecx,[eax+ecx+mSeedPacket_Offest]
mov ecx,[ecx+08]
add ecx,[eax+08]
add ecx,edx
cmp ecx,#180
jl short SeedPacket_While_Next
add edi,ebx
jmp short SeedPacket_While_Exit
SeedPacket_While_Next:
inc ebx
cmp ebx,SeedBankMax
jl short SeedPacket_While
SeedPacket_While_Exit:
pop ebx

SeedPacket_Next:
cmp edi,[ebx+24]
je originalcode
mov eax,esi
call 40CD80
mov eax,[esi+00000144]
imul edi,50
add edi,28
add eax,edi
push eax
call 488590
jmp originalcode

TakeShovel://取铲
cmp edi,C0//`
jne short TakeCobCannon
cmp byte ptr [esi+55F1],00
je short TakeCobCannon
cmp [ebx+30],6
je originalcode
cmp [ebx+30],1
je short az4
cmp [ebx+30],2
jne short az5
az4:
mov eax,esi
call 40CD80
az5:
mov edi,esi
call 412330
mov edx,5
mov ebx,esi
call 411C10
jmp originalcode

TakeCobCannon://取炮
cmp edi,50//P
jne ControltheZombie
mov edi,esi
push 0//开始序号(写0从头，写指针从后一个开始
star:
mov esi,esp
mov edx,edi
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je short end
mov esi,[esi]//esi=遍历对象的指针
cmp [esi+24],2F
jne short star
cmp dword ptr [esi+3C],25
jne short star
or eax,-1
push eax
push eax
call 466390
//jmp short star
end:
add esp,4
jmp originalcode

ControltheZombie://操控僵尸
mov ecx,[esi+138]
mov ecx,[ecx+4C]
mov edx,esi
call 41C7F0
test eax,eax
je originalcode
mov ecx,edi
call ControlZombie

originalcode:
pop ebx
pop edi
pop esi
ret 0004

exit:
jmp returnhere


