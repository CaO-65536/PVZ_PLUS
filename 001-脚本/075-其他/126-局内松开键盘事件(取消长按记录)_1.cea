[ENABLE]
alloc(newmem,2048)

newmem:
push ebx
mov ebx,[esp+8]
push esi
push edi
mov esi,ecx
mov [esi+57B4],-1
mov ecx,[esi+138]
mov ecx,[ecx+4C]
mov edx,esi
call 41C7F0
test eax,eax
je short NoZombie
mov edi,eax
mov eax,[edi]
mov ecx,[edi+00000118]
call 453CB0
test eax,eax
je end
mov esi,eax

cmp ebx,41
je short StopZombieMoving
cmp ebx,44
jne end
StopZombieMoving:
cmp byte [edi+51],0
jne end
cmp [edi+188],0
//jg end
mov eax,edi
mov ecx,14
call ZombieStartStandAnim
NoZombie:
end:
pop edi
pop esi
pop ebx
ret 4


00656CA8+C4:
dd newmem
[DISABLE]
dealloc(newmem)
00656CA8+C4:
dd 0042FB50
