[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [ecx+24],19
jne short originalcode
fld [x]
fadd [FLOATHALFEXSCREENWIDTH]
fstp [ecx+2C]
fld [y]
fstp [ecx+30]
fld [size]
fstp [ecx+11C]

originalcode:
mov edx,[esi+00000174]

exit:
jmp returnhere

x:
dd (float)190

y:
dd (float)80

size:
dd (float)0.5

401CB8:
jmp newmem
nop
returnhere:


 
 
