[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push 1D
mov ecx,esi
mov edx,[esi]
mov edx,[edx+00000124]
call edx
push eax
mov ecx,[esi+320]
mov edx,[ecx]
mov edx,[edx+20]
call edx

originalcode:
cmp dword ptr [esp+24],10

exit:
jmp returnhere

450CE3:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
