[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
lea ecx,[theColor]
call ColorGradient
lea eax,[esp+0000008C]
mov ecx,[theColor]
mov edx,[theColor+4]
push [theColor+8]
call 5643D0
jmp 0044A9A1

theColor:
dd FF 0 0 FF

theStage:
dd 0

theLapTime:
dd C8

44A988:
jmp newmem
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
44A988:
db BA F5 00 00 00
//mov edx,000000F5
