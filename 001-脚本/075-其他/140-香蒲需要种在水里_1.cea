[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(exit)

newmem:
cmp dword ptr [edx+00000134],01
je 0040E3A2
mov eax,[edx+28]
mov ecx,[edx+1C]
mov edx,[edx+04]
call 40CE00
test al,al
jne 0040E4BF

exit:
jmp returnhere

40E395:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
