[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov edx,[ebp+00000138]
cmp [edx+30],03
je 00410BD1

originalcode:
mov edx,[ebp+0000008C]

exit:
jmp returnhere

410AD9:
jmp newmem
nop
returnhere:




[DISABLE]
