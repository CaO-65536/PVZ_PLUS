[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov edx,[eax]
cmp [edx+000007F8],2B
je originalcode
cmp [edx+000007F8],32
je originalcode
cmp [eax+24],2B
jne short next
cmp [esi+24],1E
je originalcode
next:
cmp esi,eax
jne 00463668

originalcode:
mov edx,[eax+28]
cmp edx,[esi+28]

exit:
jmp returnhere

463649:
jmp newmem
nop
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
