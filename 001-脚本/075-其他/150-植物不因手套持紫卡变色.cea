[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov ecx,[esi+04]
mov ecx,[ecx+00000138]
cmp [ecx+30],03
je 004636E0

originalcode:
mov eax,[esp+0C]
call 00463420

exit:
jmp returnhere

463668:
jmp newmem
nop 4
returnhere:


 
 
