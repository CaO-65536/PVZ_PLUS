[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(originalcode)
label(exit)

newmem:
sub esp,10
fstp [esp]
fld dword ptr [esp+14+10]
fsub dword ptr [esp+0C+10]
fstp [esp+04]
mov edx,esp
lea eax,[esp+08]
mov ecx,[edi+04]//TodParticleSystem
lea ecx,[ecx+28]
call 5A3690
fld [esp+08]

originalcode:
fadd dword ptr [edi+1C]
fstp dword ptr [edi+1C]
fld [esp+0C]
add esp,10

exit:
jmp 00516E5E

516E50:
jmp newmem
nop
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
516E50:
db D8 47 1C D9 5F 1C
