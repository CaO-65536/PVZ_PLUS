dd (float)725.0 (float)401.0 (float)1.0 00000091//dd (float)740.0-15 (float)401.0 (float)1.0
dd (float)740.0 (float)450.0 (float)1.0 00000090//350.0 (float)1.0 00000090


40A63A:
jmp newmem
nop
returnhere:




