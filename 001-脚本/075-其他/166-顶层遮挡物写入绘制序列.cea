[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,[ebp+08]
mov eax,[eax+0000554C]
test eax,eax
jl short Roof
cmp eax,3
jg short Roof
push ebx
xor ebx,ebx
DrawOverCover_While:
mov edx,[ebp+08]
mov eax,[edx+0000008C]
mov ecx,[edx+ebx*4+mBushesAnimID_Offset]
call 453CB0
test eax,eax
je short DrawOverCover_Next
mov edx,eax
lea eax,[edi+edi*2]
lea eax,[esp+eax*4+18+04+04]
mov [eax],0000001A
mov ecx,[edx+68]
mov [eax+04],ecx
mov [eax+08],edx
add edi,01
DrawOverCover_Next:
inc ebx
cmp ebx,BushesRowNum
jne short DrawOverCover_While
pop ebx
jmp short originalcode


Roof:
mov eax,[ebp+08]
call 41C0B0
test al,al
je short originalcode
mov ecx,[ebp+08]
mov ecx,[ecx+0000554C]
sub ecx,04
lea eax,[edi+edi*2]
lea eax,[esp+eax*4+18+04]
mov [eax],0000001B
mov [eax+04],00058227// 5 * 2710 + 4BED7
mov [eax+08],ecx
add edi,01
jmp short originalcode

originalcode:
call 0044F400

exit:
jmp returnhere

416F47:
jmp newmem
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
