[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov edx,[006A9F38]
mov ecx,0000007F
cmp byte ptr [edx+000000F5],00
je +05
mov ecx,000000FF
cmp eax,ecx
ja 0045DA10

originalcode:
push eax
call 0061CB12

exit:
jmp returnhere

45D9F8:
jmp newmem
nop
returnhere:


 
 
