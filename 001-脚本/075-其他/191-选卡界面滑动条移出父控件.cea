[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov ecx,[esi+mChallengeScreenSlider_Offset]
mov eax,[esi]
mov edx,[eax+10]
push ecx
mov ecx,esi
call edx


originalcode:
pop edi
pop esi
pop ebx
ret 0004

exit:
jmp returnhere

42F714:
