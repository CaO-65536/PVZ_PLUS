[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
define(SHOVEL_USE_LIMIT,1E)
registersymbol(SHOVEL_USE_LIMIT)

newmem:
mov eax,[ebx+04]
cmp [eax+0000579C],SHOVEL_USE_LIMIT
jl short originalcode
push 0
push eax
call 413400


originalcode:
call 0042BAC0

exit:
jmp returnhere

42C305:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
unregistersymbol(SHOVEL_USE_LIMIT)
42C305:
db E8 B6 F7 FF FF
//call 0042BAC0
