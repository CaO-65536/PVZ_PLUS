[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,[ebp+8C]
cmp [eax+000007F8],#49
jne originalcode
push esi
sub esp,1C
mov esi,esp//输出地址
push 18
push 20+HALFEXSCREENWIDTH
push SHOVEL_USE_LIMIT//填充物*n
push [ebp+579C]//填充物*n
push string//%d/%d %s
call 5B0CA0//eax=字符串对象
add esp,C
push eax

push 2
push FF
push #224
mov eax,[ebp+579C]
mov ecx,SHOVEL_USE_LIMIT
xor edx,edx
call 511C40
add esp,0C
mov [edi+30],eax
push 2
push 0
push #187
mov eax,[ebp+579C]
mov ecx,SHOVEL_USE_LIMIT
xor edx,edx
call 511C40
add esp,0C
mov [edi+34],eax
push 2
push 00
push #98
mov eax,[ebp+579C]
mov ecx,SHOVEL_USE_LIMIT
xor edx,edx
call 511C40
add esp,0C
mov [edi+38],eax

mov eax,edi
mov ecx,[DWARVENTODCRAFT24]
mov [eax+40],ecx
mov cl,01
call 586D10
call 587120
mov eax,edi
mov cl,00
call 586D10
add esp,1C
pop esi

originalcode:
mov eax,[ebp+00000140]

exit:
jmp returnhere

align 04,00

Color:
dd #224 #187 #98 000000FF

Color_RED:
dd FF 00 00 FF

string:
db BB B9 CA A3 20 25 64 2F 25 64 20 B4 CE B2 F9 D7 D3 CA B9 D3 C3 B4 CE CA FD 00
//还剩 %d/%d 次铲子使用次数

41A232:
jmp newmem
nop
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
41A232:
db 8B 85 40 01 00 00
