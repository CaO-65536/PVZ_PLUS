[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
setle al
mov ecx,[edx+0000008C]
mov ecx,[ecx+0000082C]
mov ecx,[ecx+PlayerInfo_GameSetting_Offset+7*4]
or al,cl
ret 0004

41BABF:
jmp newmem
nop
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
41BABF:
db 0F 9E C0 C2 04 00
//setle al
//ret 0004
