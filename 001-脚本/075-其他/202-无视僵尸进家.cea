[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,[esi]
mov eax,[eax+0000082C]
mov eax,[eax+PlayerInfo_GameSetting_Offset+8*4]
test al,al
jne 0052B30A

originalcode:
mov eax,[esi]
call 004537D0

exit:
jmp returnhere

52B2FF:
jmp newmem
nop 2
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52B2FF:
db 8B 06 E8 CA 84 F2 FF
