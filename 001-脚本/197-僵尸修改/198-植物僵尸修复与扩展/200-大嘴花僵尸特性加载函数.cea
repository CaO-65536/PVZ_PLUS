//cmp byte ptr [ebp+B8],0
//jne end
push 0//攻击方式（0啃咬1砸2跳3搭梯）
push ebp//僵尸指针
call 52E780
test eax,eax
je end
Yes:
mov [ebp+28],61
mov edi,ebp
fld dword ptr [00679638]
push ecx
fstp dword ptr [esp]
push 14
push 03
push 00668E94
call PlayHeadZombieReanimation
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 14
push 00
push 006580D4
call 00528B00
jmp end

next1:
cmp eax,61//伸嘴
jne next2
fld dword ptr [num1]
push ecx
fstp [esp]
mov ecx,esi
call 00473B70
test al,al
je end
mov esi,3D
mov eax,[ebp]
call 453630
push ebp//僵尸指针
