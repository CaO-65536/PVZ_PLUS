jmp end
ToPlant:
//cmp byte ptr [ebp+B8],0
//jne no1
push 0//攻击方式（0啃咬1砸2跳3搭梯）
push ebp//僵尸指针
call 52E780
test eax,eax
jne short EatPlant
no1:
mov esi,eax
xor dl,dl
jmp az4//咬空
EatPlant:
mov esi,eax
mov ecx,[esi+24]
cmp ecx,17
je short bite
cmp ecx,32
jne short Plant_chew
bite:
push esi
mov esi,3D
mov eax,[ebp]
call 453630
pop esi
push 28
mov eax,10//不保留尸体
call NormallyHitPlant
jmp short missing
Plant_chew:
push esi//指针
call 4679B0
mov eax,[ebp]
mov ecx,[ebp+00000144]
call 453CB0
test eax,eax
je short Eat
push -1
push string
push eax
