je short az1
cmp eax,19
je short az1
cmp eax,20
jne short az2
az1:
mov dl,1
az2:
xor cl,cl
//test esi,esi
//je short az4
cmp [esi+B4],0
jg short az3
cmp [esi+B0],0
jg short az3
mov eax,esi
call 525460
test al,al
jne az4
mov eax,[esi+28]
cmp eax,0C
je az4
cmp eax,0B
jne az3
az4:
mov cl,01
az3:
test dl,dl
je short tun
push esi
mov esi,3D
mov eax,[ebp]
call 453630
pop esi
push 28
xor eax,eax
call 5317C0
mov [ebp+28],63
jmp end
tun:
test cl,cl
je short Notmissing
missing:
