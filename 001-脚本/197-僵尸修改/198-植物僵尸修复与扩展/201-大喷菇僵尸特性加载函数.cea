[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(FUME_SHROOM_ZOMBIE_Update,2048)
registersymbol(FUME_SHROOM_ZOMBIE_Update)

FUME_SHROOM_ZOMBIE_Update:
push ebp
push esi
push edi
mov edi,[esp+8+8]
mov ebp,edi
cmp byte ptr [edi+000000BA],00
je end
mov eax,[edi]
mov ecx,[edi+00000144]
call 00453CB0
mov esi,eax
mov edx,006580D4 { ("anim_idle") }
call 004745B0
test al,al
je short UpdateShooting
push [num1] { (0.40) }
mov ecx,esi
call 00473B70
test al,al
je short UpdateShooting
fld dword ptr [00679690] { (35.00) }
push ecx
fstp dword ptr [esp]
push 14
push 03
push 00668D10 { ("anim_shooting") }
call PlayHeadZombieReanimation
jmp end
UpdateShooting:
mov edx,00668D10 { ("anim_shooting") }
call 004745B0
test al,al
je end
push [num2] { (0.41) }
mov ecx,esi
call 00473B70
test al,al
je Hit
sub esp,24
mov eax,esp
call 5A3710
push eax
push ebx
push String//DoomShroom_tip
mov ebx,esi
call 472F30
pop ebx
push esi
call 472C00
mov eax,esp
sub esp,08
fld [eax+08]
fadd [edi+2C]
fsub [num4]
fstp [esp]
fld [eax+14]
fadd [edi+30]
fadd [edi+84]
fstp [esp+04]
mov eax,02
mov ecx,[edi+1C]
imul ecx,ecx,00002710
add ecx,0004AF38+1
mov edx,[edi]
call 453C80
test eax,eax
je short ShootingNext
push esi
lea esi,[eax+28]
mov ecx,edi
call 52BEE0
test al,al
jne short ShootingNext1
{push ecx
fldpi
fstp [esp]
call 5A3770}
sub esp,08
fld1
fst [esp+04]
fchs
fstp [esp]
call 5A37F0
ShootingNext1:
pop esi
ShootingNext:
add esp,24
Hit:
push [num3] { (0.57) }
mov ecx,esi
call 00473B70
test al,al
je NotHit
mov esi,1E
mov eax,[edi]
call 453630
mov ebx,edi
sub esp,20
mov edi,esp
call 532140
mov ecx,ebx
call 52BEE0
test al,al
je short NotBack
add [edi],1F
jmp short Weight
NotBack:
sub [edi],134
Weight:
mov [edi+8],154
push 0//开始序号(写0从头，写指针从后一个开始
Zombie_While_Star:
mov esi,esp
mov edx,[ebp+4]
call 41C8F0//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je Zombie_While_End
mov esi,[esi]//esi=遍历对象的指针
cmp [esi+24],19
je short Zomboss
mov eax,[esi+1C]
cmp [ebp+1C],eax
jne short Zombie_While_Star
Zomboss:
mov eax,00000009
cmp byte [ebp+B8],0
jne short MindControlled
or eax,80
MindControlled:
push eax
call 531A80
test al,al
je short Zombie_While_Star
mov ebx,esi
lea edi,[esp+14]
call 532140
lea ecx,[esp+4]
call 41C820
test eax,eax
jle short Zombie_While_Star
mov eax,2
push 14
call 5317C0
mov eax,[esi]
mov esi,1
call 453630
jmp short Zombie_While_Star
Zombie_While_End:
add esp,4
push 0//开始序号(写0从头，写指针从后一个开始
Plant_While_Star:
mov esi,esp
mov edx,[ebp+04]
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je Plant_While_End
mov esi,[esi]//esi=遍历对象的指针
mov eax,[esi+1C]
cmp [ebp+1C],eax
jne short Plant_While_Star
mov eax,00000009
cmp byte [ebp+B8],0
jne short Plant_MindControlled
or eax,80
Plant_MindControlled:
push eax
call PlantEffectedByDamage
test al,al
je short Plant_While_Star
mov ecx,esi
lea eax,[esp+14]
call 467EF0
mov ecx,eax
lea edi,[esp+4]
call 41C820
jle short Plant_While_Star
push 14
mov eax,2+10
call NormallyHitPlant
mov eax,[esi]
mov esi,1
call 453630
jmp Plant_While_Star
Plant_While_End:
add esp,4+20
NotHit:
cmp [esi+5C],1
jne short end
fld dword ptr [0067967C] { (15.00) }
push ecx
fstp dword ptr [esp]
push 14
push 03
push 006580D4 { ("anim_idle") }
call PlayHeadZombieReanimation
end:
pop edi
pop esi
pop ebp
ret 4

num1:
dd (float)0.40

num2:
dd (float)0.41

num3:
dd (float)0.57

num4:
dd (float)20

String:
db 'DoomShroom_tip' 00

[DISABLE]
