[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(PULT_ZOMBIE_Update,2048)
registersymbol(PULT_ZOMBIE_Update)

PULT_ZOMBIE_Update:
push ebp
push esi
push edi
mov edi,[esp+8+8]
cmp byte ptr [edi+000000BA],00
je end
cmp [edi+08],320
jg end
mov eax,[edi]
mov ecx,[edi+00000144]
call 00453CB0
mov esi,eax
mov edx,006580D4 { ("anim_idle") }
call 004745B0
test al,al
je UpdateShooting
push ecx
fld1
fstp [esp]
mov ecx,esi
call 00473B70
test al,al
je end//short UpdateShooting
push edi
call FindCatapultzombieTarget
test eax,eax
jne short StarShooting
push edi
call FindCatapultPlantTarget//525890
test eax,eax
je DoIdle
StarShooting:
fld dword ptr [00679690] { (35.00) }
push ecx
fstp dword ptr [esp]
push 14
push 03
push 00668D10 { ("anim_shooting") }
call PlayHeadZombieReanimation
cmp [edi+24],2A
jne end
mov eax,4
call 5AF400
test eax,eax
jne end
push 00
push 00668CC4 { ("Cornpult_butter") }
push esi
call 00473A40
push -01
push 00668D34 { ("Cornpult_kernal") }
push esi
call 00473A40
mov byte ptr [edi+BC],1
jmp end
UpdateShooting:
mov edx,00668D10 { ("anim_shooting") }
call 004745B0
test al,al
je end
cmp [esi+5C],1
je short DoIdle
push [num1] { (0.28) }
mov ecx,esi
call 00473B70
test al,al
je short end
push edi
call FindCatapultZombieTarget
test eax,eax
jne short ShootZombie
//cmp byte [edi+B8],1
//je short ShootZombie
push edi
call FindCatapultPlantTarget//00525890
mov ecx,edi
call 00525730
jmp short BackKernal
ShootZombie:
mov ecx,edi
call ZombieCatapultFireToZombie
BackKernal:
cmp [edi+24],2A
jne short end
push -01
push 00668CC4 { ("Cornpult_butter") }
push esi
call 00473A40
push 00
push 00668D34 { ("Cornpult_kernal") }
push esi
call 00473A40
mov byte ptr [edi+BC],0
jmp short end

DoIdle:
mov edx,[esi+0C]
fld dword ptr [edx+08]
push ecx
fstp dword ptr [esp]
push 14
push 00
push 006580D4 { ("anim_idle") }
call PlayHeadZombieReanimation
end:
pop edi
pop esi
pop ebp
ret 4

FindCatapultPlantTarget:
push ebx
mov ebx,[esp+08]
push esi
push edi
sub esp,21
mov edi,esp
call 5320B0
mov ecx,ebx
call 52BEE0
mov [esp+10],al
test al,al
je short Notback
mov eax,00000320
sub eax,[edi]
mov [edi+08],eax
jmp short Next
Notback:
mov eax,[edi]
mov [edi+08],eax
xor eax,eax
mov [edi],eax
Next:
push 0//目标植物权重
push 0//目标植物
push 0//开始序号(写0从头，写指针从后一个开始
Star:
mov esi,esp
mov edx,[ebx+04]
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je short End
mov esi,[esi]//esi=遍历对象的指针
mov eax,[esi+1C]
cmp [ebx+1C],eax
jne short Star
mov eax,esi
call 463EF0
test al,al
jne short Star
lea eax,[esp+0C+10]
mov ecx,esi
call 467EF0
mov ecx,eax
call 41C820
test eax,eax
jl short Star
cmp byte [esp+10],0
je short NotBack1
mov eax,[esi+08]
sub eax,[ebx+08]
jmp short Next1
NotBack1:
mov eax,[ebx+08]
sub eax,[esi+08]
Next1:
//neg eax
cmp [esp+04],0
je short SetTarget
cmp [esp+08],eax
jg short Star
SetTarget:
mov [esp+04],esi
mov [esp+08],eax
jmp short Star
End:
//add esp,4
mov eax,[esp+04]
add esp,21+C
pop edi
pop esi
pop ebx
ret 04

num1:
dd (float)0.28

[DISABLE]
dealloc(PULT_ZOMBIE_Update)
unregistersymbol(PULT_ZOMBIE_Update)
