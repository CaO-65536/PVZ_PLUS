[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(exit)

newmem:
push ebx
mov bl,al
mov ecx,[esi]
mov eax,[ecx]
mov eax,[eax+000000D8]
mov edx,[006A7AAC]//  (20)
push edx
call eax
mov [esi+000000B8],bl
mov [esi+00000154],FFFFFFFF
xor ebx,ebx
mov eax,[esi+24]
cmp eax,19
jne short next1
mov [esi+0000008C],00000000
next1:
cmp eax,08
exit:
jmp 0052FA8D

52FA60:
jmp newmem
nop 5
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
