[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
mov ebp,esi
mov esi,[esi+04]
lea edi,[esi+000000C8]
call 0041DF60
mov ecx,9
cmp [ebp+24],29
jne short Not_CABBAGE
mov ecx,2
Not_CABBAGE:
cmp [ebp+24],2A
jne short Not_KERNEL
mov ecx,A
cmp byte ptr [ebp+BC],1
jne short Not_Butter
mov ecx,C
Not_Butter:
Not_KERNEL:
cmp [ebp+24],2D
jne short originalcode
mov ecx,3
originalcode:
fld dword ptr [esp+20]
push ecx
push [ebp+20]
jmp 005257F4

5257DC:
jmp newmem
nop
[DISABLE]
dealloc(newmem)
5257DC:
mov ebp,[esi+20]
mov esi,[esi+04]
