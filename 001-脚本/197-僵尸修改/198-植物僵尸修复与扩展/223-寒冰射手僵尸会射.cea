[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp dword ptr [esi+24],21
je short exit

originalcode:
cmp dword ptr [esi+24],1A
jne 0052B252

exit:
jmp returnhere

52B245:
jmp newmem
nop
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52B245:
cmp dword ptr [esi+24],1A
jne 0052B252
//Alt: db 83 7E 24 1A 75 07
