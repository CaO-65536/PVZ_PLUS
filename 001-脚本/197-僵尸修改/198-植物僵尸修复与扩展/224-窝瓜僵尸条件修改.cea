[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ebp//僵尸指针
call 52E840
test eax,eax
je short az3
mov cl,[ebp+B8]
test cl,cl
je short az1
mov ecx,1
jmp short az2
az1:
mov ecx,81
az2:
mov esi,eax
push ecx//目标
call 531A80
test al,al
jne short exit
az3:
//cmp byte ptr [ebp+B8],1
//je 00527BB2
push 0//攻击方式（0啃咬1砸2跳3搭梯）
push ebp//僵尸指针
call 52E780
test eax,eax
je 00527BB2

originalcode:

exit:
jmp returnhere

527AB8:
jmp newmem
nop 5
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
527AB8:
cmp byte ptr [ebp+51],00
je 00527BB2
