[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
push eax
push ecx
push ebp//僵尸指针
call 52E840
pop ecx
test eax,eax
je nozombies
mov ecx,[eax+ZombieClassSize-4]
mov [ebp+F4],ecx
mov [ebp+F8],1
sub esp,20
push edi
lea edi,[esp+4]
push ebx
mov ebx,eax
call 5320B0
pop ebx
mov ecx,[edi]
pop edi
add esp,20
pop eax
jmp 527C22

nozombies:
push ecx
push 0//攻击方式（0啃咬1砸2跳3搭梯）
push ebp//僵尸指针
call 52E780
pop ecx
test eax,eax
je nothings
mov ecx,[eax+PlantClassSize-4]
mov [ebp+F4],ecx
mov [ebp+F8],2
mov ecx,[eax+8]
pop eax
jmp 527C22

nothings:
xor eax,eax
mov [ebp+F4],eax
mov [ebp+F8],eax
pop eax
lea ecx,[eax+eax*4]
shl ecx,04
jmp 527C1F

527C19:
jmp newmem
nop
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
527C19:
lea ecx,[eax+eax*4]
shl ecx,04
//Alt: db 8D 0C 80 C1 E1 04
