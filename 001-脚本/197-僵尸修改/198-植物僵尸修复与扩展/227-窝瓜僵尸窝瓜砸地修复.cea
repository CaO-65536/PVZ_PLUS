[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
mov eax,[ebp+F4]
test eax,eax
je nothings
mov ecx,[ebp+F8]
cmp ecx,2
je plant
mov ecx,eax
mov edx,[ebp+04]
call 41C7F0
test eax,eax
je short plant
mov ecx,[eax+1C]
sub esp,10
push ecx
push edi
lea edi,[esp+08]
push ebx
mov ebx,eax
call 5320B0
mov eax,[edi]
mov edi,[edi+04]
mov ecx,[ebp+04]
call 41C4C0
pop ebx
pop edi
pop ecx
add esp,10
jmp 527E28

plant:
movzx eax,ax
imul eax,PlantClassSize
mov ecx,[ebp+4]
mov ecx,[ecx+AC]
add ecx,eax
mov eax,[ecx+PlantClassSize-4]
cmp [ebp+F4],eax
jne short nothings
mov eax,[ecx+28]
mov ecx,[ecx+1C]
jmp 527E28

nothings:
push eax
xor eax,eax
mov [ebp+F4],eax
mov [ebp+F8],eax
pop eax
mov esi,[ebp+08]
mov ebx,[ebp+04]
jmp 527E08

527E02:
jmp newmem
nop
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
527E02:
mov esi,[ebp+08]
mov ebx,[ebp+04]
