[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ecx
mov ecx,ebp
call 52BEE0
pop ecx
test al,al
je short originalcode
push 2A
jmp short exit

originalcode:
push 00

exit:
mov eax,edi
lea edx,[ecx+1E]
jmp returnhere

527C8B:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
527C8B:
