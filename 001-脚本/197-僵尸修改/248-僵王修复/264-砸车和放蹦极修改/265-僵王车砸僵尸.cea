[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
push ebx
mov ebp,edi
sub esp,11
push 0//开始序号(写0从头，写指针从后一个开始
mov ecx,ebp
call 52BEE0
mov [esp+14],al
star:
mov esi,esp
mov edx,[ebp+4]
call 41C8F0//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je end
mov esi,[esi]//esi=遍历对象的基址
mov ebx,[ebp+80]
cmp byte ptr [esp+14],0
je short az3
add ebx,6
az3:
push ebx
push esi
call IsZombieInThisColumn
mov eax,ebx
add eax,2
cmp eax,ecx
jl short star
cmp ebx,edx
jg short star
mov ecx,[ebp+130]
mov eax,[esi+1C]
sub eax,ecx
test eax,eax
jl short star
cmp eax,1
jg short star
mov al,[ebp+B8]
test al,al
je short az1
mov eax,D
jmp short az2
az1:
mov eax,8D
az2:
push eax
call 531A80
test al,al
je star
push #1800//伤害
mov eax,1//形式0正面1非正面2溅伤4正面减速5非正面减速6溅伤减速7溅伤减速8无特效正面9无特效非正面A无特效溅伤
call 5317C0
jmp star
end:
add esp,15
pop ebx
//cmp byte ptr [edi+B8],1
//je 534BF2
lea esi,[esp+08]
mov [esp+08],00000000
jmp 534BA3

534B97:
jmp newmem
nop 7
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
534B97:
lea esi,[esp+08]
mov [esp+08],00000000
