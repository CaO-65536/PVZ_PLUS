alloc(newmem,2048)

newmem:
push ecx
push [ecx+80]
call 52BEE0
test al,al
je short az2
add [esp],5
az2:
mov eax,[ecx+4]
mov ecx,[ecx+00000130]
sub ecx,2
push eax
call 41C0B0
test al,al
pop eax
je short az1
dec ecx
az1:
fild [esp]
fmul qword [00679820]
fstp [esp]
call 41C6C0
pop ecx
mov eax,[ecx+4]
call 41C0D0
test al,al
je short az3
fsub [num1]
az3:
