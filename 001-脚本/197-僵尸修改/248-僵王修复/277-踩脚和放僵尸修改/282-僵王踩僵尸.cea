[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
dec esp
mov ecx,edi
call 52BEE0
mov [esp],al
push 0//开始序号(写0从头，写指针从后一个开始
star:
mov esi,esp
mov edx,[edi+4]
call 41C8F0//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je end
mov esi,[esi]//esi=遍历对象的基址
mov ecx,[edi+130]
mov eax,[esi+1C]
cmp eax,ecx
jl short star
inc ecx
cmp eax,ecx
jg short star
push eax
push esi
call IsZombieInThisColumn
mov eax,5
cmp byte ptr [esp+4],0
je short az1
xor eax,eax
az1:
cmp ecx,eax
jl short star
add eax,4
cmp edx,eax
jg short star
mov al,[edi+B8]
test al,al
je short az2
mov eax,D
jmp short az3
az2:
mov eax,8D
az3:
push eax
call 531A80
test al,al
je short star
push 708
xor eax,eax
inc eax
call 5317C0
jmp star
end:
add esp,5
//cmp byte ptr [edi+B8],1
//je 535044
mov edx,[edi+04]
lea esi,[esp+08]
jmp 534FFC

534FF5:
jmp newmem
nop 2
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
