[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ebx
push esi
sub esp,8
xor eax,eax
mov [esp],eax
mov [esp+4],eax
mov esi,[edi+4]
mov ebx,[esi+144]
lea ecx,[ebx+28]
mov ebx,[ebx+24]
az4:
test ebx,ebx
je short end
mov eax,[ecx+34]
cmp eax,30
jne short az1
mov eax,[ecx+38]
az1:
cmp eax,14
jne short az2
inc [esp]
az2:
cmp eax,E
jne short az3
inc [esp+4]
az3:
dec ebx
add ecx,50
jmp short az4
end:
mov eax,[esp]
mov ecx,[esp+4]
add esp,8
pop esi
pop ebx
cmp eax,ecx
jl short ice
jg short fire

originalcode:
mov eax,00000002

exit:
