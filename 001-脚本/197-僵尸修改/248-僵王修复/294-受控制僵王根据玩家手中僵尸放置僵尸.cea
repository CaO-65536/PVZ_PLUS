[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp byte [edi+15D],0
je short originalcode
mov eax,[esi+4]
call 40CD10
mov ecx,eax
call 42B530
test al,al
je short originalcode
mov eax,ecx
call 42A040
push ebx
jmp 534E0A

originalcode:
mov eax,[esi+60]
cmp eax,00000DAC

exit:
jmp returnhere

534DC0:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
534DC0:
mov eax,[esi+60]
cmp eax,00000DAC
//Alt: db 8B 46 60 3D AC 0D 00 00
