label(returnhere)
label(originalcode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here

originalcode:
cmp eax,3C
jl 42B57B
cmp eax,3D+NUM_ZOMBIE_TYPES
jl 42B57E
jmp 42B57B

exit:
jmp returnhere

42B530:
jmp newmem
returnhere:


 
 
