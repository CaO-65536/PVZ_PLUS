[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp dword ptr [esp+10],5C
je short exit

originalcode:
cmp dword ptr [esp+10],49
jne 438FE0

exit:
jmp returnhere

438FCB:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
438FCB:
cmp dword ptr [esp+10],49
//Alt: db 83 7C 24 10 49
