push eax
mov ecx,ebx
call 52BEE0
test al,al
pop eax
pop ecx
je short originalcode
fchs

originalcode:
fstp dword ptr [esi+34]
mov ecx,[ebx+000000AC]

exit:
jmp returnhere

5270F2:
jmp newmem
nop 4
returnhere:


 
 
