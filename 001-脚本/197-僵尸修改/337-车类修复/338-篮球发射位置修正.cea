[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
call 52BEE0
test al,al
pop eax
jne short originalcode
fadd qword ptr [00679980]
cmp [ecx+24],16
je short exit
fsub dword [num2]
jmp short exit
originalcode:
fsub dword [num1]
cmp [ecx+24],16
je short exit
fadd dword [num3]

exit:
test eax,eax
jmp returnhere

num1:
dd (float)42

num2:
dd (float)60

num3:
dd (float)70

52573E:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
