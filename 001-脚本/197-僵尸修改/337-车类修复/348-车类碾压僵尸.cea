[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ebx
push esi
sub esp,20
push 0//开始序号(写0从头，写指针从后一个开始
star:
mov esi,esp
mov edx,[edi+04]
call 41C8F0//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je end
mov esi,[esi]//esi=遍历对象的基址
cmp [esi+24],19
je short star
mov eax,[edi+1C]
cmp [esi+1C],eax
jne short star
push edi
mov ebx,edi
lea edi,[esp+04+04]
call 532140
pop edi
push edi
lea edi,[esp+14+04]
mov ebx,esi
call 5320B0
pop edi
lea ecx,[esp+04]
push ecx
push eax
call TwoRectIsOverlap
test al,al
je short star
mov al,[edi+B8]
test al,al
je short az1
mov eax,1
jmp short az2
az1:
mov eax,81
az2:
push eax
call 531A80
test al,al
je short star
push 1//伤害
mov eax,0//形式0正面1非正面2溅伤4正面减速5非正面减速6溅伤减速7溅伤减速8无特效正面9无特效非正面A无特效溅伤
call 5317C0
jmp star
end:
add esp,20+04
pop esi
pop ebx

originalcode:
mov eax,[edi]
cmp dword ptr [eax+00000768],00

exit:
jmp returnhere

52EE7F:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
