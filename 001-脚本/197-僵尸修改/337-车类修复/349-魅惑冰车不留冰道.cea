[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here

originalcode:
cmp dword ptr [esi+24],0C
jne 52B204
cmp byte ptr [esi+B8],1
je 52B204

exit:
jmp returnhere

52B1F9:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52B1F9:
cmp dword ptr [esi+24],0C
jne 0052B204
//Alt: db 83 7E 24 0C 75 05
