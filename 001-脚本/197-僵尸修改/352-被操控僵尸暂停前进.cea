je short originalcode
mov eax,[esi+188]
test eax,eax
je 0052A7A4
cmp eax,2
je 0052A7A4

originalcode:
//cmp [esi+28],C
//je 0052A7A4
cmp byte ptr [esi+51],00
jne 0052A7A4

exit:
