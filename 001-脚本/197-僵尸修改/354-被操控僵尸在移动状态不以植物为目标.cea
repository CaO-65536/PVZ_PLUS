[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp byte [ebp+15D],0
je short originalcode
cmp [ebp+188],1
je 0052E578

originalcode:
mov eax,[ebp+28]
cmp eax,20

exit:
jmp returnhere

52E561:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52E561:
mov eax,[ebp+28]
cmp eax,20
