[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp eax,#73
jne short run
fldz
push ecx
fstp dword ptr [esp]
push esi
push 00
push 006580D4
call 00528B00
pop edi
pop ebx
pop ecx
ret

run:
cmp eax,B
jne short originalcode
fldz
push ecx
fstp dword ptr [esp]
push esi
push 00
push anim_run
call 00528B00
pop edi
pop ebx
pop ecx
ret
originalcode:
cmp eax,1F
jne 0052F360

exit:
jmp returnhere

52F344:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52F344:
cmp eax,1F
jne 0052F360
//Alt: db 83 F8 1F 75 17
