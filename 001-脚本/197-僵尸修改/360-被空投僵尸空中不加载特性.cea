[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp dword ptr [esi+64],09
je 52B278

originalcode:
cmp dword ptr [esi+24],03
jne 0052B180

exit:
jmp returnhere

52B174:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52B174:
cmp dword ptr [esi+24],03
jne 0052B180
//Alt: db 83 7E 24 03 75 06
