[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [edi+D8],1
je 0052F39B

originalcode:
cmp byte ptr [edi+000000BD],00

exit:
jmp returnhere

52F360:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52F360:
cmp byte ptr [edi+000000BD],00
//Alt: db 80 BF BD 00 00 00 00
