[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,[esi+178]
mov [esi+28],eax
mov eax,[esi+17C]
mov [esi+64],eax
mov eax,[esi+180]
mov [esi+68],eax
push esi
mov eax,esi
xor esi,esi
call 52F2E0
pop esi

originalcode:
push esi
call 0052F9C0

exit:
jmp returnhere

528F16:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
