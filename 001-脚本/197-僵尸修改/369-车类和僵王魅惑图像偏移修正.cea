[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
test dl,dl
je 52C593
cmp [edi+24],C
jne short az1
fld [esp+18]
fadd [num1]
fstp [esp+18]
jmp short originalcode
az1:
cmp [edi+24],16
jne short next1//originalcode
fld [esp+18]
fadd [num2]
fstp [esp+18]
jmp short originalcode
next1:
cmp [edi+24],19
jne short originalcode
fld [esp+18]
fadd [num3]
fstp [esp+18]
mov eax,[edi+04]
test eax,eax
je short originalcode
call 41C0B0
test al,al
je short originalcode
fld [esp+1C]
fadd [num4]
fstp [esp+1C]

originalcode:
fld dword ptr [edi+0000011C]

exit:
jmp returnhere

num1:
dd (float)-136

num2:
dd (float)51

num3:
dd (float)700

num4:
dd (float)60

52C57B:
jmp newmem
nop 5
returnhere:


 
 
