[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
mov eax,ebp
call 534680
test al,al
pop eax
jne 52FBEA
push ecx
push eax
mov ecx,ebp
call 52BEE0
test al,al
pop eax
pop ecx
jne 52FBEA

originalcode:


exit:
jmp returnhere

52FBA5:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52FBA5:
cmp dword ptr [ebp+24],11
je 52FBEA
