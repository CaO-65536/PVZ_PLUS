[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push 01
push edi
mov edx,edi
mov edi,[edx+C]
mov eax,[edx+8]
add eax,4B
mov ecx,[edx+4]
call 41C4C0
pop edi
test eax,eax
jle short originalcode
mov ecx,[edi+1C]
lea edx,[eax+eax*2+2D]
lea eax,[ecx+edx*2]
mov ecx,[edi+4]
cmp dword ptr [ecx+eax*4],03
jne short originalcode
push -28
jmp short exit
originalcode:
push 00

exit:
push FFFFFF38
jmp returnhere

528B9D:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
