[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
pushad
sub esp,110
mov [esp+10],ebp
mov ebp,edi
xor edi,edi
push 0//开始序号(写0从头，写指针从后一个开始
star:
mov esi,esp
mov edx,[6A9EC0]
mov edx,[edx+768]
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je end
mov esi,[esi]//esi=遍历对象的基址
cmp [esi+28],ebx
jne star
cmp [esi+1C],ebp
jne star
cmp esi,[esp+14]
je star
mov eax,[esi+24]
cmp eax,4
je star
cmp eax,8
je star
cmp eax,9
je star
cmp eax,15
je star
cmp eax,21
je star
cmp eax,2E
je star
mov edi,esi
end:
add esp,114
test edi,edi
popad
jne short exit

originalcode:
mov esi,eax
call 0044D000

exit:
jmp returnhere

467A31:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
