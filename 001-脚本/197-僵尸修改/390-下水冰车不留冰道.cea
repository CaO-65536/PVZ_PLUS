[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov edx,[esi+04]
mov cl,1
cmp [esi+BD],cl
jne short originalcode
mov eax,7FFFFFFF
jmp 0052A88D

originalcode:
mov ecx,[edx+0000554C]

exit:
jmp returnhere

52A862:
jmp newmem
nop 4
returnhere:


 
 
