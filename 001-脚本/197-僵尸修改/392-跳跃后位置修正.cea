[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov ecx,esi
call 52BEE0
test al,al
je short originalcode
fadd qword ptr [00679890]
jmp short exit

originalcode:
fsub qword ptr [00679890]

exit:
jmp returnhere

526023:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
