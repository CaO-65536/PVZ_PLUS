[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ecx
fldz
xor al,al
cmp [edi+BD],al
je short originalcode
fadd dword ptr [6796D0]

originalcode:
fstp dword ptr [edi+00000084]

exit:
jmp returnhere

52851D:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52851D:
fldz 
push ecx
fstp dword ptr [edi+00000084]
