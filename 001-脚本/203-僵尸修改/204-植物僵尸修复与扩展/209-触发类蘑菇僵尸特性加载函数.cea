align 10,CC

KillAllPlantsAndZombiesInGrid:
push edi
mov edi,[esp+08]
push 0//开始序号(写0从头，写指针从后一个开始
KillAllPlantsAndZombiesInGrid_Zombie_Star:
mov esi,esp
mov edx,edi
call 41C8F0//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je short KillAllPlantsAndZombiesInGrid_Zombie_End
mov esi,[esi]//esi=遍历对象的指针
cmp [esp+14],esi
je short KillAllPlantsAndZombiesInGrid_Zombie_Star
mov eax,[esp+10]
cmp [esi+1C],eax
jne short KillAllPlantsAndZombiesInGrid_Zombie_Star
mov eax,[esp+0C]
push eax
push esi
call IsZombieInThisColumn
test al,al
je short KillAllPlantsAndZombiesInGrid_Zombie_Star
mov ecx,esi
call 530510
jmp short KillAllPlantsAndZombiesInGrid_Zombie_Star
KillAllPlantsAndZombiesInGrid_Zombie_End:
add esp,4
push 0//开始序号(写0从头，写指针从后一个开始
KillAllPlantsAndZombiesInGrid_Plant_Star:
mov esi,esp
mov edx,edi
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je short KillAllPlantsAndZombiesInGrid_Plant_End
mov esi,[esi]//esi=遍历对象的指针
cmp [esp+18],esi
je short KillAllPlantsAndZombiesInGrid_Plant_Star
mov eax,[esp+10]
cmp [esi+1C],eax
jne short KillAllPlantsAndZombiesInGrid_Plant_Star
mov eax,[esp+0C]
cmp [esi+28],eax
jne short KillAllPlantsAndZombiesInGrid_Plant_Star
push esi
call 4679B0
jmp short KillAllPlantsAndZombiesInGrid_Plant_Star
KillAllPlantsAndZombiesInGrid_Plant_End:
add esp,4
pop edi
ret 14
