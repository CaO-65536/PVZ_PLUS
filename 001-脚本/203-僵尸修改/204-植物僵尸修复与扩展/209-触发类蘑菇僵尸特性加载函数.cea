[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(DOOM_SHROOM_ZOMBIE_Update,4096)
registersymbol(DOOM_SHROOM_ZOMBIE_Update)
label(ICE_SHROOM_ZOMBIE_Update)
registersymbol(ICE_SHROOM_ZOMBIE_Update)

//ExplodeShroom_ZOMBIE_Update:
DOOM_SHROOM_ZOMBIE_Update:
push ebp
push esi
push edi
mov edi,[esp+8+8]
cmp byte ptr [edi+000000BA],00
je DOOM_SHROOM_ZOMBIE_Update_End
cmp [edi+28],00
jne DOOM_SHROOM_ZOMBIE_Update_Next1
cmp [edi+68],00
jne DOOM_SHROOM_ZOMBIE_Update_End
mov [edi+28],66
mov eax,[edi]
mov esi,00000039
call 00453630
fld dword ptr [00679774] { (23.00) }
push ecx
fstp [esp]
push 14
push 03
push 00668C64//  ("anim_explode")
call PlayHeadZombieReanimation
fld dword ptr [00679388]
push ecx
fstp dword ptr [esp]
push 14
push 00
push 006580D4
call 00528B00
mov eax,[edi]
mov ecx,[edi+00000144]
call 453CB0
mov ebx,eax
fld1
push 00668E14 { ("DoomShroom_head1") }
call 472F30
mov ecx,[ebx+58]
lea eax,[eax+eax*2]
shl eax,05
fstp dword ptr [eax+ecx+34]
push 00668E28 { ("DoomShroom_head2") }
call 472F30
fld dword ptr [006793E0] { (2.00) }
mov ecx,[ebx+58]
lea eax,[eax+eax*2]
shl eax,05
fst dword ptr [eax+ecx+34]
push 00668E3C { ("DoomShroom_head3") }
call 00472F30
mov edx,[ebx+58]
lea ecx,[eax+eax*2]
shl ecx,05 { 5 }
fstp dword ptr [ecx+edx+34]
jmp DOOM_SHROOM_ZOMBIE_Update_End
DOOM_SHROOM_ZOMBIE_Update_Next1:
cmp [edi+28],66//蓄力期间
jne DOOM_SHROOM_ZOMBIE_Update_End
mov eax,[edi]
mov ecx,[edi+00000144]
call 453CB0
mov esi,eax
mov edx,00668C64//  ("anim_explode")
call 4745B0
test al,al
je DOOM_SHROOM_ZOMBIE_Update_End
cmp [esi+5C],0
je DOOM_SHROOM_ZOMBIE_Update_End
sub esp,10
mov ebx,edi
mov edi,esp
call 5320B0
mov eax,[edi+08]
cdq
sub eax,edx
sar eax,1
add [edi],eax
mov eax,[edi+0C]
cdq
sub eax,edx
sar eax,1
add [edi+04],eax
mov ecx,[ebx]
mov edx,[ecx]
mov eax,[006A7898]
mov edx,[edx+000000D8]
push eax
call edx
xor eax,eax
mov al,FF
mov cl,[ebx+B8]
shl cl,7
xor al,cl
push eax
push 01
push 03
push DoomShroomRadius
push [edi+04]
push [edi]
push [ebx+1C]
push [ebx+04]
call UnitedBoom
mov eax,[edi+0C]
cdq
sub eax,edx
sar eax,1
add eax,[edi+04]
mov [edi+0C],eax
push edi
mov eax,[edi]
mov edi,[edi+0C]
mov ecx,[ebx+04]
call PixelToGridX
pop edi
mov [edi+08],eax
push 00//Plant* PlantSelf
push ebx//Zombie* ZombieSelf
push [ebx+1C]//GridY
push eax//GridX
push [ebx+04]//*Board this
call KillAllPlantsAndZombiesInGrid
sub esp,08
fild [edi+04]
fstp dword ptr [esp+04]
fild [edi]
fstp dword ptr [esp]
mov eax,1E
mov ecx,00061A80
mov edx,[ebx]
call 453C80
mov edx,[edi+08]
mov edi,[ebx+1C]
mov eax,[ebx+04]
push edx
call 00408F80
mov [eax+18],00004650
add esp,10
mov eax,[ebx+04]
mov [eax+00005540],0000000C
mov [eax+00005544],00000003
mov [eax+00005548],FFFFFFFC
mov ecx,ebx
call 530510
//jmp 00466AAA
DOOM_SHROOM_ZOMBIE_Update_End:
pop edi
pop esi
pop ebp
ret 4
{
push Zombie* this
}
