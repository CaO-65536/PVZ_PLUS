[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(TORCHWOOD_ZOMBIE_Update,2048)
registersymbol(TORCHWOOD_ZOMBIE_Update)

TORCHWOOD_ZOMBIE_Update:
push ebp
mov ebp,esp
push esi
push edi
mov ebx,[esp+8+8]
sub esp,24
cmp byte ptr [ebx+000000BA],00
je end
mov edi,esp
call 532140
//push 0//开始序号(写0从头，写指针从后一个开始
mov [esp+20],0
TORCHWOOD_ZOMBIE_Update_Star:
lea esi,[esp+20]
mov ebx,[ebp+08]
mov edx,[ebx+04]
call 41C9B0//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je short TORCHWOOD_ZOMBIE_Update_End
mov esi,[esi]//esi=遍历对象的指针
mov eax,[esi+1C]
cmp [ebx+1C],eax
jne short TORCHWOOD_ZOMBIE_Update_Star
xor al,al
test [esi+74],80
jne short TORCHWOOD_ZOMBIE_Update_L1
mov al,1
TORCHWOOD_ZOMBIE_Update_L1:
cmp [ebx+B8],al
jne short TORCHWOOD_ZOMBIE_Update_Star
mov ebx,[esi+5C]
test ebx,ebx
je short TORCHWOOD_ZOMBIE_Update_True
cmp ebx,01
jne short TORCHWOOD_ZOMBIE_Update_Star
TORCHWOOD_ZOMBIE_Update_True:
lea ecx,[esp+10]
call 46EBC0
mov ecx,eax
call 41C820
cmp eax,0A
jng short TORCHWOOD_ZOMBIE_Update_Star
test ebx,ebx
jne short TORCHWOOD_ZOMBIE_Update_IceBall
mov eax,[ebp+08]
mov eax,[eax+ZombieClassSize-4]
mov ecx,esi
call ConvertToFireball//046ECB0
jmp short TORCHWOOD_ZOMBIE_Update_Star
TORCHWOOD_ZOMBIE_Update_IceBall:
cmp ebx,01
jne short TORCHWOOD_ZOMBIE_Update_Star
mov ecx,[ebp+08]
mov ebx,[ecx+ZombieClassSize-4]
mov eax,esi
call ConvertToPea//0046EE00
jmp short TORCHWOOD_ZOMBIE_Update_Star
TORCHWOOD_ZOMBIE_Update_End:
add esp,24
end:
pop edi
pop esi
mov esp,ebp
pop ebp
ret 4

ConvertToFireball:
sub esp,08
push ebp
push esi
push edi
mov edi,ecx
cmp [edi+98],eax
je 0046EDEF
mov [edi+98],eax
fldz
jmp 0046ECC6

ConvertToPea:
push ecx
push esi
push edi
mov edi,eax
cmp [edi+98],ebx
je 0046EE70
mov [edi+98],ebx
lea esi,[edi+7C]
call 004053E0
mov [edi+5C],00000000
jmp 0046EE1C

[DISABLE]
dealloc(TORCHWOOD_ZOMBIE_Update)
unregistersymbol(TORCHWOOD_ZOMBIE_Update)
