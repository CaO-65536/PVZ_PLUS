[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
test esi,esi
je short originalcode
cmp [edi+24],24
jne short originalcode
cmp [esi+24],24
jne short next
mov eax,2
call 5AF400
test eax,eax
je short originalcode
next:
push esi
mov eax,[edi]
mov esi,00000044
call 453630
push [edi+C8]
mov eax,9
mov esi,edi
call 5317C0
pop esi
mov al,[edi+000000B8]
call 52FA60
mov edi,esi
jmp 0052B9DE

originalcode:
cmp byte ptr [edi+000000B8],00

exit:
jmp returnhere

52BAD7:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
