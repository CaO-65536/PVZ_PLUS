[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
cmp dword ptr [esi+24],22
jne short FUME_SHROOM_ZOMBIE
push esi
call Chomper_Zombie_Update
FUME_SHROOM_ZOMBIE:
cmp dword ptr [esi+24],23
jne short PULT_ZOMBIE
push esi
call FUME_SHROOM_ZOMBIE_Update
PULT_ZOMBIE:
cmp dword ptr [esi+24],29
je short Update_PULT_ZOMBIE
cmp dword ptr [esi+24],2A
je short Update_PULT_ZOMBIE
cmp dword ptr [esi+24],2D
jne short DOOM_SHROOM_ZOMBIE
Update_PULT_ZOMBIE:
push esi
call PULT_ZOMBIE_Update
DOOM_SHROOM_ZOMBIE:
cmp dword ptr [esi+24],26
jne short ICE_SHROOM_ZOMBIE
push esi
call DOOM_SHROOM_ZOMBIE_Update
ICE_SHROOM_ZOMBIE:
cmp dword ptr [esi+24],25
jne short TORCHWOOD_ZOMBIE
push esi
call ICE_SHROOM_ZOMBIE_Update
TORCHWOOD_ZOMBIE:
cmp dword ptr [esi+24],27
jne short originalcode
push esi
call TORCHWOOD_ZOMBIE_Update
originalcode:
pop edi
pop esi
pop ebx
ret

52B278:
jmp newmem
returnhere:


 
 
