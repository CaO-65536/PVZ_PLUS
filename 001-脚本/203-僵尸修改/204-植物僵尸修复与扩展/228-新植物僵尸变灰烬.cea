[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(exit)

newmem:
cmp edi,1F
je 00532F34
cmp edi,21
jl short exit
cmp edi,NUM_ZOMBIE_TYPES
jl 00532F34

exit:
jmp returnhere

532CD3:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
532CD3:
cmp edi,1F
je 00532F34
