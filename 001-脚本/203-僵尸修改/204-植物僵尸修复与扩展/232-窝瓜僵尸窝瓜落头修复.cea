[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
push eax
mov eax,[ebp+F4]
test eax,eax
je nothings
mov ecx,[ebp+F8]
cmp ecx,2
je plant
cmp ecx,1
jne nothings
movzx eax,ax
imul eax,ZombieClassSize
mov ecx,[ebp+4]
mov ecx,[ecx+90]
add ecx,eax
mov eax,[ecx+ZombieClassSize-4]
cmp [ebp+F4],eax
jne short plant
sub esp,10
push edi
lea edi,[esp+4]
push ebx
mov ebx,ecx
call 5320B0
pop ebx
mov edx,[edi]
pop edi
add esp,10
pop eax
jmp 527DAE

plant:
movzx eax,ax
imul eax,PlantClassSize
mov ecx,[ebp+4]
mov ecx,[ecx+AC]
add ecx,eax
mov eax,[ecx+PlantClassSize-4]
cmp [ebp+F4],eax
jne short nothings
mov edx,[ecx+8]
pop eax
jmp 527DAE

nothings:
xor eax,eax
mov [ebp+F4],eax
mov [ebp+F8],eax
pop eax
lea edx,[eax+eax*4]
shl edx,04
jmp 527DAB

527DA5:
jmp newmem
nop
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
527DA5:
lea edx,[eax+eax*4]
shl edx,04
