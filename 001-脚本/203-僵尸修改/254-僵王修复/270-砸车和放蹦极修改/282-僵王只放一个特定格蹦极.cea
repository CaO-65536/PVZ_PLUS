[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,[ebp+8]
cmp [eax+00000188],0
je short originalcode
mov [eax+00000188],0
fstp dword ptr [esi+00000084]
mov [ebx-04],ecx
jmp 0053529C

originalcode:
cmp edi,03

exit:
fstp dword ptr [esi+00000084]
jmp returnhere

53528A:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
