[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov ecx,edi
call 52BEE0
test al,al
je short originalcode
cmp dword ptr [edx+28],03
jg 00535034
jmp short Next

originalcode:
cmp dword ptr [edx+28],05
jl 00535034

Next:
mov al,[edx+00000147]
cmp [edi+000000B8],al
jne 00535034

exit:
jmp returnhere

535028:
jmp newmem
nop
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
535028:
db 83 7A 28 05 7C 06
//cmp dword ptr [edx+28],05
//jl 00535034
