[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [esi+5C],1
jle short originalcode
mov ecx,edi//僵尸指针
call 5302F0

originalcode:
cmp dword ptr [ebx+5C],00
jle 00533D7A

exit:
jmp returnhere

533D6D:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
533D6D:
cmp dword ptr [ebx+5C],00
jle 00533D7A
