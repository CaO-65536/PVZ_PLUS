[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp byte [edi+15D],0
jne 005366BB

originalcode:
cmp dword ptr [edi+68],00
jne 005366BB

exit:
jmp returnhere

53660E:
jmp newmem
nop 5
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
