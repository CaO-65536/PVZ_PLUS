[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [ecx+30],2
jne originalcode
mov edx,[ecx+34]
and edx,FFFF
imul edx,edx,0D8
mov eax,[eax+E4]
add eax,edx
push esi
mov esi,eax
call 432DD0
pop esi
jmp 42A44B

originalcode:
mov ecx,[ecx+24]
mov eax,[eax+00000144]

exit:
jmp returnhere

42A433:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
