[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
mov eax,ebx
call 42B530
test al,al
pop eax
je short originalcode
mov ecx,9
jmp 4877FB

originalcode:
cmp ebx,30
jne 0048778B

exit:
jmp returnhere

487782:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
