[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
lea eax,[esp+000000B4]
push edi
mov edi,ebx
call 46EF00
pop edi

originalcode:
push 00
lea ecx,[esp+00000158]

exit:
jmp returnhere

46FA7B:
jmp newmem
nop 4
returnhere:




[DISABLE]
