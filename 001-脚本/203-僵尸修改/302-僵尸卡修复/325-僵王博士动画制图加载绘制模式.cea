[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov edi,ebx
lea eax,[esp+14]
call 46EF00
lea eax,[esp+B4]
call 46EF00

originalcode:
push 00
lea ecx,[esp+00000158]

exit:
jmp returnhere

46FC57:
jmp newmem
nop 4
returnhere:




