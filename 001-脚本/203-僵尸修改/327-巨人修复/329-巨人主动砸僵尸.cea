[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
//cmp byte ptr [ebx+B8],1
//je originalcode
test eax,eax
jne 005272AC

originalcode:
push edi
sub esp,60
push 0//开始序号(写0从头，写指针从后一个开始
star:
mov esi,esp
mov edx,[ebx+4]
call 41CA70//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je end
mov esi,[esi]//esi=遍历对象的基址
lea edi,[esp+10]
call 532140
lea ecx,[esp+34]
fld [esi+8]
call 6397D0
mov [ecx],eax
fld [esi+C]
call 6397D0
mov [ecx+4],eax
mov [ecx+8],32
mov [ecx+C],50
call 41C820
test eax,eax
jl star
mov eax,[esi+14]
cmp [ebx+1C],eax
jne short star
cmp [esi+2C],1
jne short star
jmp short yes
end:
add esp,60
pop edi
push ebx
call 52E840
test eax,eax
jne 005272AC

exit:
mov ecx,[ebx]
jmp returnhere

yes:
add esp,60
pop edi
jmp 005272AC

52724A:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52724A:
test eax,eax
jne 005272AC
mov ecx,[ebx]
