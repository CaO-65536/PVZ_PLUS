[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ecx
push eax
mov al,[ebx+B8]
mov [esi+B8],al
mov ecx,ebx
call 52BEE0
test al,al
pop eax
pop ecx
je short originalcode
fadd qword ptr [0067A2B8]
jmp short exit

originalcode:
fsub qword ptr [0067A2B8]

exit:
jmp returnhere

5270A3:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
