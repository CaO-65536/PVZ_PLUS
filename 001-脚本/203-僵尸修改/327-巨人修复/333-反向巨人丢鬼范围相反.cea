[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ecx
push eax
mov ecx,ebx
call 52BEE0
test al,al
pop eax
pop ecx
je short originalcode
fld [number1]//800.0
fsub [ebx+2C]
fabs
jmp short az1

originalcode:
fld dword ptr [ebx+2C]
az1:
fsub qword ptr [0067A050]

exit:
cmp eax,45
jmp returnhere

number1:
dd (float)800

526EE7:
jmp newmem
nop 4
returnhere:


 
 
