[ENABLE]
define(num,100)
52CC8B:
add esp,num+C
52CAF0:
mov edi,[esp+num+20]
52CC68:
mov edi,[esp+num+20]
52CC79:
mov ecx,[esp+num+10]
alloc(newmem,2048)

newmem:
lea edx,[esp+14]
mov eax,[esp+10C]
mov eax,[eax+80]
cmp [ebx+28],eax
je short az1
sub eax,[ebx+28]
imul eax,-50
push eax
fild [esp]
pop eax
fadd [edx+8]
fstp [edx+8]
az1:
push edx
jmp 52CC4E
newmem1:
sub esp,00000100
mov [esp+FC],ecx
jmp 52CAAB

52CC49:
jmp newmem
52CAA5:
jmp newmem1
nop
[DISABLE]
52CC8B:
add esp,00000108
52CAF0:
mov edi,[esp+0000011C]
52CC68:
mov edi,[esp+0000011C]
52CC79:
mov ecx,[esp+0000010C]
dealloc(newmem)
52CC49:
lea edx,[esp+14]
push edx
52CAA5:
sub esp,000000FC
