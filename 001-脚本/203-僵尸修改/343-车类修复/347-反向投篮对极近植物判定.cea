label(exit)

newmem:
fldz
push ecx
fstp [esp]
mov eax,ecx
call 52A580
mov edx,eax
fstp st(0)
mov ecx,[ebp+08]
call 52BEE0
test al,al
je short Left
mov eax,[esp+0C]
mov ecx,[ebp+08]
mov ecx,[ecx+08]
sub edx,ecx
shl edx,01
add ecx,edx
mov edx,[eax+08]
