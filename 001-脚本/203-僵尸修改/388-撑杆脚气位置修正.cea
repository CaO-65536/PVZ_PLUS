[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ecx
mov ecx,esi
call 52BEE0
pop ecx
test al,al
jne short exit

originalcode:
add edx,51

exit:
sub esp,08
jmp returnhere

52AC1B:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52AC1B:
add edx,51
sub esp,08
