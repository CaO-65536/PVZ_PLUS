[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp eax,0C
je 0052E770
cmp eax,15
jne short exit
mov eax,[esp+2C]
cmp eax,3
mov eax,[ebp+28]
jne short exit
jmp 52E5E0


originalcode:

exit:
jmp returnhere

52E5A3:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52E5A3:
cmp eax,0C
je 0052E770
//Alt: db 83 F8 0C 0F 84 C4 01 00 00
