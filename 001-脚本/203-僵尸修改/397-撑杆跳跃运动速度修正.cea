[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push esi//僵尸指针
call 52E840
mov ecx,0
test eax,eax
jne zombie
originalcode:
push 02
push esi
call 0052E780
mov ecx,1
test eax,eax
jne zombie

exit:
jmp returnhere

zombie:
push edi
push ebx
sub esp,24
mov [esp+20],ecx
mov [esp+10+28],eax
fld dword ptr [00679638]
push ecx
fstp dword ptr [esp]
push 14
push 03
push 0066EB30
mov edi,esi
mov [esi+28],0000000C
call 00528B00
mov eax,[esi+00000118]
mov ecx,[esi]
mov edx,[ecx+00000820]
mov edx,[edx+08]
and eax,0000FFFF
lea eax,[eax+eax*4]
shl eax,05
add eax,[edx]
fild dword ptr [eax+1C]
fdiv dword ptr [eax+08]
fmul qword ptr [006792A0]
fstp dword ptr [esp+14+28]
mov edx,[esp+10+28]
cmp [esp+20],1
je short Plant
mov ebx,edx
mov edi,esp
call 5320B0
jmp short Next
Plant:
mov ecx,edx
mov eax,esp
call 467EF0
Next:
mov ebx,esi
lea edi,[esp+10]
call 5320B0
mov ecx,esp
call 41C820
neg eax
add eax,[esp+8]
sub eax,50
test eax,eax
jnl short next1
xor eax,eax
next1:
add esp,20
pop ebx
pop edi
mov [esp+10],eax
mov ecx,[esi]
jmp 525EDB


525DF2:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]
