[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
push ecx
mov ecx,edi
call 52BEE0
pop ecx
test al,al
pop eax
je short originalcode
add ecx,53
jmp short exit

originalcode:
sub ecx,53

exit:
mov [esp+1C],ecx
jmp returnhere

5262AA:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
5262AA:
sub ecx,53
mov [esp+1C],ecx
