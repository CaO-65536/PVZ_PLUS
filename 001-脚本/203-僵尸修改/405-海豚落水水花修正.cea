[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
mov ecx,edi
call 52BEE0
test al,al
pop eax
je short originalcode
add edx,43*3
jmp short exit

originalcode:
sub edx,3F

exit:
fstp dword ptr [esp+04]
jmp returnhere

5265BB:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
5265BB:
sub edx,3F
fstp dword ptr [esp+04]
