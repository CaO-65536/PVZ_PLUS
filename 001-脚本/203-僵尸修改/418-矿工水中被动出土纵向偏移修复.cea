[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
xor cl,cl
cmp [edi+BD],cl
je short originalcode
fadd dword ptr [6796D0]

originalcode:
fstp dword ptr [edi+00000084]

exit:
jmp returnhere

528701:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
528701:
fstp dword ptr [edi+00000084]
//Alt: db D9 9F 84 00 00 00
