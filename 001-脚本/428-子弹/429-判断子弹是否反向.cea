[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(IsProjectileLeft,1024)
registersymbol(IsProjectileLeft)

IsProjectileLeft:
push ebp
mov ebp,[esp+8]
mov eax,[ebp+58]
cmp eax,6
je short yes
cmp eax,7
je short az1
cmp eax,9
jne short az2
az1:
fldz
fcomp dword ptr [edi+3C]
fnstsw ax
test ah,41
je short yes
az2:
cmp eax,A
je short yes
cmp eax,B
je short yes
xor al,al
pop ebp
ret 4
yes:
mov al,1
pop ebp
ret 4
{
push //*Projectile
}

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(IsProjectileLeft)
unregistersymbol(IsProjectileLeft)
