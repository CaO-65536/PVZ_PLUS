[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)

newmem:
push [ebp+74]
call PlantEffectedByDamage
test al,al
je 0046CAD0
mov edi,[esi+1C]
mov edx,[ebp+04]
mov esi,[esi+28]
cmp [ebp+58],1
je 0046CBC9
jmp 0046CB6C

46CB5D:
jmp newmem
nop 2
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
46CB5D:
cmp dword ptr [ebp+5C],0D
mov edi,[esi+1C]
