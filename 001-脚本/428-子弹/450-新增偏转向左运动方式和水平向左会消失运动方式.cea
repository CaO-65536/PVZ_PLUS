[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp eax,0A
jne short originalcode
fld dword ptr [ebx+30]
fsub qword ptr [006796A0]
fstp dword ptr [ebx+30]
jmp 0046DBF6

originalcode:
cmp eax,0B
jne short az1
fld dword ptr [ebx+30]
fsub qword ptr [006796A0]
fstp dword ptr [ebx+30]
jmp 0046DC1F
az1:
cmp eax,02
fld dword ptr [ebx+30]

exit:
jmp returnhere

46DBE5:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
46DBE5:
cmp eax,02
fld dword ptr [ebx+30]
//Alt: db 83 F8 02 D9 43 30
