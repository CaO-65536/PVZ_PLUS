[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(exit)

newmem:
call 00453C80
mov edx,eax//粒子指针
cmp [ebp+5C],2
jne short Not_CABBAGE
mov esi,[006A7928]
jmp short SetImage
Not_CABBAGE:
cmp [ebp+5C],A
jne short Not_KERNEL
mov esi,[006A7700]
jmp short SetImage
Not_KERNEL:
cmp [ebp+5C],C
jne short Not_BUTTER
mov esi,[006A7284]
jmp short SetImage
Not_BUTTER:
cmp [ebp+5C],3
jne short Not_MELON
mov esi,[006A78E8]
jmp short SetImage
Not_MELON:
cmp [ebp+5C],5
jne short exit
mov esi,[006A7308]
SetImage:
//mov esi,//贴图
call 518600

exit:
jmp returnhere

46D75B:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
46D75B:
call 00453C80
