[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
call 005321F0
test eax,eax
je returnhere
lea esi,[eax+28]
sub esp,08
fld [edi+9C]
fst [esp]
fstp [esp+04]
call 5A37F0

originalcode:

exit:
jmp returnhere

46E41B:
jmp newmem
returnhere:




[DISABLE]
