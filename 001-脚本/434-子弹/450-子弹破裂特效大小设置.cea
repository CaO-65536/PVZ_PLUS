test eax,eax
je returnhere
lea esi,[eax+28]
sub esp,08
fld [edi+9C]
fst [esp]
fstp [esp+04]
call 5A37F0

originalcode:

exit:
jmp returnhere

46E44C:
jmp newmem
returnhere:




