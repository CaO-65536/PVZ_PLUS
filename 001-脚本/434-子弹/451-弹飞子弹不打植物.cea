label(returnhere)
label(originalcode)
label(exit)

newmem:
mov al,[ebp+51]
test al,al
jne 46CC22

originalcode:
lea ecx,[esp+10]
mov esi,ebp

exit:
jmp returnhere

46CAAB:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
