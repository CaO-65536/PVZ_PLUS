[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp dword ptr [edi+58],7
jne short originalcode
push eax
fld [edi+3C]
fldz
fcompp
sahf
pop eax
jle short exit

originalcode:
cmp dword ptr [edi+58],6
jne 0046ED8D

exit:
fldpi
fstp [edi+68]
{mov [edi+6C],(float)0.05
mov [edi+58],7}
jmp 46ED8D

46ED6F:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
46ED6F:
cmp dword ptr [edi+58],06
jne 0046ED8D
//Alt: db 83 7F 58 06 75 18
