[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [ebp+5C],B
jne short originalcode
cmp [ebp+58],1
je 0046D648

originalcode:
push ebp
call 0046CD40
test eax,eax
jne short az1
mov eax,[ebp+74]
//test al,al
//jns short no
push ebp
call 0046CAA0
mov esi,eax
jmp short exit
az1:
//xor esi,esi
mov edi,eax
fstp st(0)
fldz
jmp 46D65E
exit:
jmp returnhere

no:
xor eax,eax
mov esi,eax
jmp short exit

46D656:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
