alloc(PlantDieThing,2048)
registersymbol(PlantDieThing)

PlantDieThing:
push ebx
xor bl,bl
push esi
mov esi,[esp+C]
cmp [esi+24],11
jne short az2
cmp [esi+3C],00
jne short NotSquish
az2:
cmp byte ptr [esi+00000142],00
jne short end
cmp dword ptr [esi+00000134],02
je short end
cmp byte ptr [esi+00000141],00
jne short end
cmp byte ptr [esi+00000143],00
jne short end
cmp [esi+14C],0
jg short end
cmp [esi+150],0
jg short end
mov eax,[esi+24]
cmp eax,2
je short az1
cmp eax,14
je short az1
cmp eax,0E
je short az1
cmp eax,0F
je short az1
cmp eax,31
je short az1
cmp eax,32
je short az1
cmp eax,35
je short az1
cmp eax,04
jne short end
cmp dword ptr [esi+3C],00
je short end
az1:
push esi
call 004666A0
NotSquish:
mov bl,1
end:
mov al,bl
pop esi
pop ebx
ret 4
{
