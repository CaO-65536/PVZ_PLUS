[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp [edi+58],1
jne 00464B6D

originalcode:
cmp [eax+10],esi
jne 00464B6D

exit:
jmp returnhere

464B5A:
jmp newmem
returnhere:


 
 
[DISABLE]
