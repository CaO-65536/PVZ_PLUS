[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp byte ptr [esp+30],01
je short exit

originalcode:
cmp byte ptr [esp+30],00

exit:
jmp returnhere

40E35A:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
40E35A:
cmp byte ptr [esp+30],00
//Alt: db 80 7C 24 30 00
