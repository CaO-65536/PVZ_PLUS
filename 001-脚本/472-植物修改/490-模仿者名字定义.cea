[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
mov eax,[esp+000000A0]
call 42B530
test al,al
pop eax
je short originalcode
lea edx,[esp+4C]
mov eax,[esp+0000009C]
call 42A040
push 0
push eax
push edx
call ZombieGetNameString
mov esi,eax
jmp 467C9F

originalcode:
push ecx
push 006555A0

exit:
jmp returnhere

467C8D:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
