[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov ecx,[eax+24]
cmp ebx,30
je short originalcode
cmp ecx,30
jne short originalcode
mov ecx,[eax+138]

originalcode:
cmp ecx,ebx
jne 0040D412

exit:
jmp returnhere

40D40A:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
40D40A:
cmp [eax+24],ebx
jne 0040D412
