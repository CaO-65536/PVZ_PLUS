[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(exit)

newmem:
mov eax,[esp+10]
mov esi,[eax+158]
inc esi
az1:
test esi,esi
je short exit
call 00463E40
mov eax,[esp+10]
sub esi,1
jmp short az1

exit:
mov eax,[esp+10]
mov [eax+158],0
jmp returnhere

4130F0:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
4130F0:
mov eax,[esp+10]
call 00463E40
