label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,[edi+0000014C]
test eax,eax
jle short next1
add eax,-01
mov [edi+0000014C],eax
next1:
mov eax,[edi+00000150]
test eax,eax
jle short next2
add eax,-01
mov [edi+00000150],eax
next2:
mov eax,[edi+00000154]
test eax,eax
jle short originalcode
add eax,-01
mov [edi+00000154],eax

originalcode:
cmp byte ptr [edi+00000142],00

exit:
jmp returnhere

464E3C:
