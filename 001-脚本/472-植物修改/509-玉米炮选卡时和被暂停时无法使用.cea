[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(exit)

newmem:
push edi
mov eax,[esi]
cmp [eax+7FC],3
jne 00466413
mov eax,esi
call PlantIsRealStop
test al,al
jne 00466413
cmp dword ptr [esi+3C],25

exit:
jmp returnhere

466390:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
