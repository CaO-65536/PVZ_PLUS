[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp esi,2F
jne short originalcode
fld qword ptr [num1]
jmp short exit

originalcode:
fld qword ptr [00679820]

exit:
jmp returnhere

num1:
dq (double)160

463B98:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
463B98:
fld qword ptr [00679820]
//Alt: db DD 05 20 98 67 00
