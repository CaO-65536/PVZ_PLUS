[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
originalcode:
add esi,[esp+34]//取僵尸中心纵坐标
sub esi,[esp+14]//减去杨桃中心纵坐标
mov [esp+2C],esi
fild [esp+2C]
fabs//距离绝对值
fld qword [00679998] { (0.52) }
call 63A180//计算正弦值，取斜向纵速度
fmul qword [006796A0] { (3.33) }
fstp [esp+2C]
fdiv [esp+2C]
push ecx
fstp [esp]//斜向子弹打到僵尸时间
mov eax,ebx
call 52A580//预判的僵尸x坐标
fist [esp+30]
fstp [esp+2C]
cmp [ebx+1C],0
je short az2
mov eax,[ebx+4]
mov ecx,[ebx+1C]
fld [esp+2C]
push ecx
fstp [esp]
call 41C6C0
call 6397D0
mov ecx,[esp+34]
sub ecx eax
mov [esp+34],eax
add [esp+3C],ecx
az2:
sub esp,10

fild [esp+34+10]
fisub [esp+14+10]
fild [esp+30+10]
fisub [esp+C+10]
call 639EFA
fstp [esp]

fild [esp+34+10]
fiadd [esp+3C+10]
fisub [esp+14+10]
fild [esp+30+10]
fisub [esp+C+10]
call 639EFA
fstp [esp+4]

fild [esp+34+10]
fisub [esp+14+10]
fild [esp+30+10]
fiadd [esp+38+10]
fisub [esp+C+10]
call 639EFA
fstp [esp+8]

fild [esp+34+10]
fiadd [esp+3C+10]
fisub [esp+14+10]
fild [esp+30+10]
fiadd [esp+38+10]
fisub [esp+C+10]
call 639EFA
fstp [esp+C]
xor esi,esi

push [ebp+8]
call IsPlantLeft
test al,al
je short az3
fldpi
fsub qword [00679998] { (0.52) }
jmp short az1
az3:
fld qword [00679998] { (0.52) }
az1:
fld dword ptr [esp]
fcomp st(0),st(1)
fnstsw ax
mov cl,ah
fld dword ptr [esp+4]
fcomp st(0),st(1)
fnstsw ax
mov ch,ah
fld dword ptr [esp+8]
fcomp st(0),st(1)
fnstsw ax
mov dl,ah
fld dword ptr [esp+C]
fcomp st(0),st(1)
fnstsw ax
mov dh,ah
add esp,10
mov dh,ah
cmp cl,ch
jne 0045F6CF
cmp ch,dl
jne 0045F6CF
cmp dl,dh
jne 0045F6CF
cmp esi,1
je 0045F6AB
inc esi
sub esp,10
fchs
jmp az1

exit:
jmp returnhere

45F5E9:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
