[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
push ecx
call IsPlantLeft
test al,al
pop eax
jne short originalcode
neg eax

originalcode:
cmp dword ptr [ecx+24],2B

exit:
jmp returnhere

4677E9:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
4677E9:
neg eax
cmp dword ptr [ecx+24],2B
//Alt: db F7 D8 83 79 24 2B
