[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push edi
call IsPlantLeft
test al,al
je short originalcode
fchs

originalcode:
fstp dword ptr [esp+14]
cmp dword ptr [edi+24],32

exit:
jmp returnhere

462D28:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
462D28:
fstp dword ptr [esp+14]
cmp dword ptr [edi+24],32
