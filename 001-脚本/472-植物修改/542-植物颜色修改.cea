[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(originalcode)
label(exit)

newmem:
lea ecx,[esp+10]
call 564370
cmp byte [esi+00000142],0
je short NextColor
cmp byte [esi+00000146],0
jne 00463709
NextColor:
cmp [esi+14C],0
jg short AddColdColor
cmp [esi+154],0
jng short originalcode
AddColdColor:
push esi
push edi
mov edi,ColdColor
mov esi,eax
sub esp,10
mov edx,esp
call 512F80
mov ecx,[eax]
mov [esi],ecx
mov ecx,[eax+04]
mov [esi+04],ecx
mov ecx,[eax+08]
mov [esi+08],ecx
mov ecx,[eax+0C]
mov [esi+0C],ecx
mov eax,esi
add esp,10
pop edi
pop esi

originalcode:
{cmp dword ptr [esi+24],31
jne short exit
push esi
push edi
mov edi,RedColor
mov esi,eax
sub esp,10
mov edx,esp
call 512F80
mov ecx,[eax]
mov [esi],ecx
mov ecx,[eax+04]
mov [esi+04],ecx
mov ecx,[eax+08]
mov [esi+08],ecx
mov ecx,[eax+0C]
mov [esi+0C],ecx
mov eax,esi
add esp,10
pop edi
pop esi}


exit:
mov ecx,BlackColor
call 5644B0
test eax,eax
je 004636F4
lea eax,[esp+10]
jmp 00463709

ColdColor:
dd 4B 4B FF FF

RedColor:
dd FF 40 40 FF

BlackColor:
dd 00 00 00 FF

4636E0:
jmp newmem
nop
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
4636E0:
db 83 7E 24 31 75 0E
//cmp dword ptr [esi+24],31
//jne 004636F4
