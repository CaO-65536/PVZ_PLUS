[ENABLE]
alloc(newmem,2048)

newmem:
test eax,eax
jne 004609F8
push esi
call FindSquashTargetPlant
test eax,eax
je 00460DC2
mov ecx,[eax+PlantClassSize-4]
mov [esi+0000015C],ecx
mov ecx,[eax+28]
lea ecx,[ecx+ecx*4]
shl ecx,4
add ecx,28
cmp [eax+24],2F
jne 00460A26
add ecx,28
jmp 00460A26

4609F0:
jmp newmem
nop 3
[DISABLE]
dealloc(newmem)
4609F0:
test eax,eax
je 00460DC2
