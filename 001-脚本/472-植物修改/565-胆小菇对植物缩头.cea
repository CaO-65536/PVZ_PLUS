[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp byte ptr [esp+13],00
jne short originalcode
push 0//开始序号(写0从头，写指针从后一个开始
star:
mov esi,esp
mov edx,[edi+04]
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je short end
mov esi,[esi]//esi=遍历对象的指针
cmp esi,edi
je short star
mov al,[esi+147]
cmp [edi+147],al
je short star
mov eax,[esi+1C]
sub eax,[edi+1C]
inc eax
cmp eax,2
ja short star
mov ecx,esi
lea eax,[esp+18+4]
call 467EF0
push 78
mov ecx,[edi+08]
mov edx,[edi+0C]
add edx,14
call 41C850
add esp,04
test al,al
je short star
mov [esp+13+4],al
jmp short star
end:
add esp,4

originalcode:
mov eax,[edi]
mov ecx,[eax+00000820]

exit:
jmp returnhere

4604E6:
jmp newmem
nop 3
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
