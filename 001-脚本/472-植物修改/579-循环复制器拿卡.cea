alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp edx,HITRESULTTYPE_DUPLICATORCARD
jne short originalcode
mov eax,[esp+10]
mov ecx,[eax+04]
cmp byte ptr [ecx+00000164],00
jne 00412320
lea eax,[eax+D8]
push eax
call 00488590
mov eax,[edi+00000138]
cmp [eax+30],01
jne short Next
mov [eax+24],-1
mov [eax+30],04
mov ecx,[esp+10]
mov ecx,[ecx+PlantClassSize-4]
mov [eax+38],ecx
Next:
call 0040E520
pop edi
pop esi
pop ebx
mov esp,ebp
pop ebp
ret 000C

originalcode:
cmp edx,0F
jne 004122A2

exit:
jmp returnhere

