[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push edi
call 52E840
mov esi,eax
test esi,esi
jne 52BAD7

originalcode:
cmp dword ptr [edi+28],3C
je 52BB34

exit:
jmp returnhere

52B948:
jmp newmem
nop 5
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52B948:
cmp dword ptr [edi+28],3C
je 52BB34
