[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
push edi
call 52E840
mov ecx,eax
pop eax
test ecx,ecx
jne 52BC9A
cmp [edi+18C],2
je 52BC9A

originalcode:
mov ecx,[eax+24]
cmp ecx,03

exit:
jmp returnhere

52BB9F:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
52BB9F:
mov ecx,[eax+24]
cmp ecx,03
