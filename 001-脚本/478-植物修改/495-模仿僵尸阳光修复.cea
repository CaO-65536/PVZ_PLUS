[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp edx,-01
je 00467B9E

originalcode:
mov eax,edx
push eax
call 42B530
test al,al
pop eax
je short exit
call 467B00
ret
exit:
jmp returnhere

467B8E:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
467B8E:
cmp edx,-01
je 00467B9E
