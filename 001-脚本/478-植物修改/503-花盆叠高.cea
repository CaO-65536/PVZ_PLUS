[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(exit)

newmem:
mov edx,[ebp+08]
push ebx
mov ebx,[ebp+0C]
push edx
mov edx,edi
call GetNumberOfFlowerPotsAt
test eax,eax
je 00465130//00465113
cmp esi,21
je short az3
dec eax
az3:
push eax
fild [esp]
pop eax
fmul qword [006794E8]
fchs
fadd [esp+8]
fstp [esp+8]
exit:
jmp 00465113

4650F8:
jmp newmem
nop
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
