[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here

originalcode:
test edx,edx
je short exit
cmp [edx+24],21
jne 0040E511
xor edx,edx
exit:
jmp returnhere

40E2A0:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
40E2A0:
test edx,edx
jne 0040E511
