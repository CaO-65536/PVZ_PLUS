[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp ecx,19
jne short originalcode
cmp [edi+14C],0
jg short originalcode
cmp [edi+150],0
jg short originalcode
call plantspeedup
originalcode:
cmp ecx,13
jne 004633D3

exit:
jmp returnhere

plantspeedup:
push 0//开始序号(写0从头，写指针从后一个开始
star:
mov esi,esp
mov edx,[6A9EC0]
mov edx,[edx+768]
call 41C950//41C950遍历植物函数41C8F0遍历僵尸函数41C9B0遍历子弹函数41CA10遍历物品函数41CA70遍历推车函数41CAD0遍历场地物品函数
test al,al
je end
mov esi,[esi]//esi=遍历对象的基址
mov eax,[edi+1C]
sub eax,[esi+1C]
cmp eax,-1
jl short star
cmp [esi+24],2F
je short next
cmp eax,1
jg short star
mov eax,[edi+28]
sub eax,[esi+28]
cmp eax,-1
jl short star
cmp eax,1
jg short star
next2:
mov al,[edi+00000147]
cmp [esi+00000147],al
jne short star
mov eax,[esi+24]
cmp eax,19
je short star
cmp eax,10
je short star
cmp eax,1E
je short star
cmp eax,21
je short star
cmp eax,17
je short star
mov ecx,[esi]
call 453840
test al,al
jne short az1
mov eax,[esi+24]
cmp eax,3
je short star
cmp eax,31
je short star
cmp eax,32
je short star
az1:
add [esi+158],1
//mov eax,esi
//call 463E40
jmp star
end:
add esp,4
ret
next:
cmp eax,2
jg star
jmp short next2

4633C6:
jmp newmem
returnhere:


 
 
