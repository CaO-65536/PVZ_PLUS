[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
originalcode://00463BAE
push ebx
call IsPlantLeft
cmp esi,34
jne short az1
test al,al
jne 00463BAE
jmp short exit
az1:
test al,al
je 00463BAE

exit:
jmp returnhere

463B8F:
jmp newmem
returnhere:


 
 
[DISABLE]
