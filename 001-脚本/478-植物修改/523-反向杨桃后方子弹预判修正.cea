[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push eax
push ecx
call IsPlantLeft
test al,al
pop eax
je short originalcode
cmp [esp+0C],eax
jl 0045F6D1
jmp short exit

originalcode:
cmp eax,[esp+0C]
jl 0045F6D1

exit:
jmp returnhere

45F51B:
jmp newmem
nop 5
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
45F51B:
cmp eax,[esp+0C]
jl 0045F6D1
