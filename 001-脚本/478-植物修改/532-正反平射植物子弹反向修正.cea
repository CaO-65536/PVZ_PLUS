//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ebp
call IsPlantLeft
test al,al
je short originalcode
mov ecx,[esp+38]
cmp [ecx+58],0
jne short next1
mov [ecx+58],6
fldpi
fstp [ecx+68]
jmp short originalcode
next1:
cmp [ecx+58],6
jne short originalcode
mov [ecx+58],0
fldz
fstp [ecx+68]

originalcode:
pop edi
pop esi
pop ebp
pop ebx
add esp,1C

exit:
jmp returnhere

4673A6:
