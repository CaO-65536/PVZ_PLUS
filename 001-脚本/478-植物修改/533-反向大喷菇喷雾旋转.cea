[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push edi
call IsPlantLeft
test al,al
je short originalcode
sub edx,35
jmp short next

originalcode:
add edx,55
next:
push edx
call 0045EEA0
test eax,eax
je short exit
push eax
push edi
call IsPlantLeft
test al,al
pop eax
je short exit
push esi
lea esi,[eax+28]
{push ecx
fldpi
fstp [esp]
call 5A3770}
sub esp,08
fld1
fst [esp+04]
fchs
fstp [esp]
call 5A37F0
pop esi

exit:
jmp returnhere

4648B7:
jmp newmem
nop 4
returnhere:


 
 
[DISABLE]
