[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov ecx,[esi+PlantClassSize-4]
mov [edi+90],ecx
push eax
push esi
call IsPlantLeft
test al,al
pop eax
je short originalcode
fld [edi+3C]
fchs
fstp [edi+3C]

originalcode:
fstp dword ptr [edi+40]
add eax,01

exit:
jmp returnhere

45F871:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
45F871:
fstp dword ptr [edi+40]
add eax,01
