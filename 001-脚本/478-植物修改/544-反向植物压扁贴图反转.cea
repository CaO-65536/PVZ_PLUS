[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(originalcode)
label(exit)

newmem:
fld1
push eax
push ebx
call IsPlantLeft
mov cl,al
pop eax
test cl,cl
je short originalcode
fchs

originalcode:
fstp dword ptr [esp]
call 005878D0
test cl,cl
je 00465B70
fld [eax+08]
cmp [ebx+24],2F
jne short next
fadd qword ptr [00679820]

next:
fadd qword ptr [00679820]

fstp [eax+08]

exit:
jmp 00465B70

465B66:
jmp newmem
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
