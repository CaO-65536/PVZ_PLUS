[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push ebx
call IsPlantLeft
test al,al
je short originalcode
fld [esi+08]
cmp [ebx+24],2F
jne short next
fsub qword ptr [00679820]

next:
fsub qword ptr [00679820]

fstp [esi+08]

originalcode:
mov ecx,[esp+000000B4]

exit:
jmp returnhere

465BB8:
jmp newmem
nop 2
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
465BB8:
db 8B 8C 24 B4 00 00 00
