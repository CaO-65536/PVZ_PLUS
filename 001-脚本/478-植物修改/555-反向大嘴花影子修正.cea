[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push edi
call IsPlantLeft
test al,al
je short originalcode
fld [num]
jmp short exit

originalcode:
fld dword ptr [006799FC]

exit:
jmp returnhere

align 04,00
num:
dd (float)13

46587A:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
46587A:
db D9 05 FC 99 67 00
//fld dword ptr [006799FC]
