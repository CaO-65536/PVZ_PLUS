[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
push esi
call IsPlantLeft
test al,al
je short originalcode
cmp [esi+08],ecx
jmp short exit

originalcode:
cmp ecx,[esi+08]

exit:
push ecx
mov [esi+00000080],ecx
jmp returnhere

460A26:
jmp newmem
nop 5
returnhere:




[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
460A26:
cmp ecx,[esi+08]
push ecx
mov [esi+00000080],ecx
