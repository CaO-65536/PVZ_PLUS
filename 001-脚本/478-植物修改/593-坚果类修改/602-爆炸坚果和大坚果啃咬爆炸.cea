[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,[esi+24]
cmp eax,31
je short az1
cmp eax,32
jne short originalcode
az1:
push esi
call 004666A0
originalcode:
push esi
call 4679B0

exit:
jmp returnhere

52FD54:
jmp newmem
nop
returnhere:


 
 
