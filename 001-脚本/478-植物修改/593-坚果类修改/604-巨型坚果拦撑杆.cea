label(returnhere)
label(originalcode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here

originalcode:
cmp dword ptr [eax+24],17
je short exit
cmp dword ptr [eax+24],32
jne 00526015

exit:
jmp returnhere

525FA4:
jmp newmem
nop
returnhere:


 
 
