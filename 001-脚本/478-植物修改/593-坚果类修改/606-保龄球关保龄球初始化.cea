[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
define(STATE_BOWLING_NORMAL,31)
registersymbol(STATE_BOWLING_NORMAL)

newmem:
mov [esi+3C],STATE_BOWLING_NORMAL
call 45E7C0
mov [esi+20],eax

originalcode:
push 00668C20

exit:
jmp returnhere

45DDBE:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
unregistersymbol(STATE_BOWLING_NORMAL)
45DDBE:
db 68 20 8C 66 00
