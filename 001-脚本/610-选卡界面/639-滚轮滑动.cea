newmem:
push ebp
mov ebp,esp
push esi
mov esi,ecx

sub esp,C
mov eax,esp
fild [ebp+8]
fchs
fisub [esi+17C]
fist [esp]
pop eax
test eax,eax
jl short az2
cmp eax,8
jng short az1
az2:
fstp st(0)
jmp short end
az1:
push 8
fidiv [esp]
pop ecx
fst qword [esp]//双浮点数值

mov esi,[esi+178]
