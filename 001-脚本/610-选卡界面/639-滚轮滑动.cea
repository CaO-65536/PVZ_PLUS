mov edx,[ecx]
mov edx,[edx+00000118]//取函数地址
call edx
sub esp,8
fstp qword [esp]
push 0
mov ecx,[esi+88]
mov edx,[ecx]
mov edx,[edx]
call edx
end:
pop esi
mov esp,ebp
pop ebp
ret 4

