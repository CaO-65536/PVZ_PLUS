484817:
mov [esp+18],ChosenSeedNumber//白色底板
4867AE:
mov ebx,ChosenSeedNumber//双击快速选卡
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)
registersymbol(ChosenSeedNumber)

newmem:
cmp esi,35
jne originalcode
add esi,7
originalcode:
cmp esi,ChosenSeedNumber
jl 00483DA0

exit:
jmp returnhere

483E00:
jmp newmem
returnhere:


 
 
