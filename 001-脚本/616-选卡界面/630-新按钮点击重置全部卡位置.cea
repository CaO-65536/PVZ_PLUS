[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
cmp edi,6B
jne short originalcode
xor [esi+SeedChooserScreen_Page_Offest],1
push edi
mov edi,esi
push 0
while:
mov ecx,[esp]
imul edx,ecx,3C
lea edx,[esi+edx+A4]
//cmp [edx+24],1
//je short Setpos
cmp [edx+24],3
jne short next
Setpos:
lea ebx,[edx+04]
push ebx
sub ebx,4
call 484400
next:
inc [esp]
cmp [esp],35
jne short next1
add [esp],7
next1:
cmp [esp],ChosenSeedNumber
jne short while
pop ecx
pop edi

originalcode:
cmp edi,66
jne 00485C19

exit:
jmp returnhere

485BF5:
jmp newmem
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
