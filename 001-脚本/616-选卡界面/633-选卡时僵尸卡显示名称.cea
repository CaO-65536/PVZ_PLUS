[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem:
mov eax,edi
call 42B530
test al,al
je originalcode
mov eax,edi
call 42A040
push 0
push eax
lea edx,[esp+1C]
push edx
call ZombieGetNameString
jmp 4864E5

originalcode:
push -01
lea edx,[esp+1C]

exit:
jmp returnhere

4864D5:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
4864D5:
push -01
lea edx,[esp+1C]
