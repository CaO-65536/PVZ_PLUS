[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(exit)

newmem:
mov ecx,[esi+00000150]
mov eax,[esi+00000178]
test eax,eax
je short az1
cmp byte ptr [eax+59],0
je short az1
pop esi
ret
az1:
mov eax,[esi+00000160]
test eax,eax
je short az2
cmp byte ptr [eax+59],0
jne 00482E31
az2:
cmp byte ptr [esi+58],0
je short exit
mov eax,2
jmp 482E36
exit:
mov eax,ecx
jmp returnhere

482DD3:
jmp newmem
nop
returnhere:


 
 
[DISABLE]
